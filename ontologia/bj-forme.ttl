# SHACL shapes for the data of the verse ontology (ontologia/bj-dati.ttl.gz): the Bible, the
# Dizionario di Teologia Biblica, the front matter and the appendices, the links between the parts, the
# quotations and the time line (the last sections).
# Checked by tools/ontologia/verifica_rdf.py with pyshacl, on the whole graph.

@prefix bj:      <https://massimo-nocentini.github.io/bibbia-gerusalemme/ontologia#> .
@prefix bjf:     <https://massimo-nocentini.github.io/bibbia-gerusalemme/forme#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dc:      <http://purl.org/dc/elements/1.1/> .
@prefix oa:      <http://www.w3.org/ns/oa#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix schema:  <https://schema.org/> .

bjf:Bibbia a sh:NodeShape ;
    sh:targetClass bj:Bibbia ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:datatype rdf:langString ] .

bjf:Testamento a sh:NodeShape ;
    sh:targetClass bj:Testamento ;
    sh:property [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Bibbia ] ,
                [ sh:path bj:ordine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

bjf:Libro a sh:NodeShape ;
    sh:targetClass bj:Libro ;
    sh:property [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Testamento ] ,
                [ sh:path bj:codiceOsis ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[1-3]?[A-Z][A-Za-z]+$" ] ,
                [ sh:path bj:sigla ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:ordine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 1 ; sh:maxInclusive 74 ] ,
                [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path bj:volume ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

bjf:Capitolo a sh:NodeShape ;
    sh:targetClass bj:Capitolo ;
    sh:property [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Libro ] ,
                [ sh:path bj:inLibro ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Libro ] ,
                [ sh:path bj:numero ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ,
                [ sh:path bj:etichetta ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

bjf:Divisione a sh:NodeShape ;
    sh:targetClass bj:Divisione ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path bj:livello ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( 1 2 3 ) ] ,
                [ sh:path bj:inLibro ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Libro ] ,
                [ sh:path bj:inDivisione ; sh:maxCount 1 ; sh:class bj:Divisione ] ,
                [ sh:path bj:inizio ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Versetto ] ,
                [ sh:path bj:fine ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Versetto ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

bjf:Pericope a sh:NodeShape ;
    sh:targetClass bj:Pericope ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path bj:titoloBreve ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path bj:inLibro ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Libro ] ,
                [ sh:path bj:inDivisione ; sh:maxCount 1 ; sh:class bj:Divisione ] ,
                [ sh:path bj:inizio ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Versetto ] ,
                [ sh:path bj:fine ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Versetto ] ,
                [ sh:path bj:dentroVersetto ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path bj:apreCapitolo ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

bjf:Versetto a sh:NodeShape ;
    sh:targetClass bj:Versetto ;
    sh:property [ sh:path bj:testo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ;
                  sh:languageIn ( "it" ) ] ,
                [ sh:path bj:testoHtml ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ] ,
                [ sh:path dcterms:identifier ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[1-3]?[A-Z][A-Za-z]+\\.([0-9]+|Prol)\\.[0-9]+[a-z]?$" ] ,
                [ sh:path bj:etichetta ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^([0-9]+,)?[0-9]+[a-z]?$" ] ,      # "25,19": Nm 25,19 printed in Nm 26
                [ sh:path bj:numero ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:suffisso ; sh:maxCount 1 ; sh:pattern "^[a-z]$" ] ,
                [ sh:path bj:numeroCapitolo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ,
                [ sh:path bj:ordine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Pagina ] ,
                [ sh:path bj:poesia ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Capitolo ] ,
                [ sh:path bj:inLibro ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Libro ] ,
                [ sh:path bj:inPericope ; sh:maxCount 1 ; sh:class bj:Pericope ] ,
                [ sh:path bj:precede ; sh:maxCount 1 ; sh:class bj:Versetto ] ,
                [ sh:path bj:segue ; sh:maxCount 1 ; sh:class bj:Versetto ] ,
                [ sh:path bj:omesso ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path bj:traParentesi ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path bj:stampatoNelCapitolo ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:titoloSalmo ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path bj:acrostico ; sh:maxCount 3 ; sh:datatype xsd:string ; sh:pattern "^[A-ZŚŠ][a-z]+$" ] ,
                [ sh:path bj:haLetteraAcrostica ; sh:maxCount 3 ; sh:class bj:LetteraAcrostica ] ,
                [ sh:path bj:nellIndice ; sh:class bj:VoceIndice ] ,
                [ sh:path bj:haNota ; sh:class bj:Nota ] ,
                [ sh:path bj:rimandaA ; sh:class bj:Versetto ] ,
                [ sh:path bj:paralleloA ; sh:class bj:Versetto ] ,
                [ sh:path bj:doppioneDi ; sh:class bj:Versetto ] ,
                [ sh:path bj:citatoIn ; sh:class bj:Versetto ] ,
                [ sh:path bj:rinviaANotaChiave ; sh:class bj:Versetto ] ,
                [ sh:path bj:citatoNellaVoce ; sh:class bj:Voce ] .

bjf:Pagina a sh:NodeShape ;
    sh:targetClass bj:Pagina ;
    sh:property [ sh:path bj:numero ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:paginaPdf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

bjf:Introduzione a sh:NodeShape ;
    sh:targetClass bj:Introduzione ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path bj:introduce ; sh:minCount 1 ; sh:class bj:Libro ] ,
                [ sh:path bj:citaVersetto ; sh:class bj:Versetto ] .

bjf:Paragrafo a sh:NodeShape ;
    sh:targetClass bj:Paragrafo ;
    sh:property [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:or ( [ sh:class bj:Introduzione ] [ sh:class bj:TestoPreliminare ] ) ] ,
                [ sh:path bj:testo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path bj:numero ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

# A note: a Web Annotation with exactly one textual body, one anchor verse, a scope and
# at least one target; its target is a passage, a chapter or a book.
bjf:Nota a sh:NodeShape ;
    sh:targetClass bj:Nota ;
    sh:property [ sh:path oa:hasBody ; sh:minCount 1 ; sh:maxCount 1 ; sh:node bjf:Corpo ] ,
                [ sh:path oa:motivatedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue oa:commenting ] ,
                [ sh:path bj:richiamataDa ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Versetto ] ,
                [ sh:path bj:ambito ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( bj:ambitoVersetti bj:ambitoCapitolo bj:ambitoLibro ) ] ,
                [ sh:path oa:hasTarget ; sh:minCount 1 ;
                  sh:or ( [ sh:class bj:Passaggio ] [ sh:class bj:Capitolo ] [ sh:class bj:Libro ] ) ] ,
                [ sh:path bj:commenta ; sh:class bj:Versetto ] ,
                [ sh:path bj:citaVersetto ; sh:class bj:Versetto ] ,
                [ sh:path bj:etichetta ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:posizioneTesto ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ,
                [ sh:path bj:posizioneHtml ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Pagina ] .

bjf:Corpo a sh:NodeShape ;
    sh:class oa:TextualBody ;
    sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ,
                [ sh:path dc:format ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "text/plain" ) ] ,
                [ sh:path dc:language ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "it" ) ] .

bjf:Margine a sh:NodeShape ;
    sh:targetClass bj:Margine ;
    sh:property [ sh:path bj:accantoA ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Versetto ] ,
                [ sh:path bj:testo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ,
                [ sh:path bj:posizione ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:posizioneTesto ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:posizioneHtml ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:stampatoNelVersetto ; sh:maxCount 1 ; sh:class bj:Versetto ] .

# What a margin reference and a citation share: printed text, status, booleans; a
# resolved (or partial) one names at least one passage or a whole book, an unresolved
# one says why.
bjf:Riferimento a sh:NodeShape ;
    sh:targetClass bj:Rimando , bj:Citazione ;
    sh:property [ sh:path bj:testo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ,
                [ sh:path bj:stato ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( bj:risolto bj:parziale bj:irrisolto bj:nonRiferimento ) ] ,
                [ sh:path bj:aPassaggio ; sh:class bj:Passaggio ] ,
                [ sh:path bj:notaChiave ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path bj:conParalleli ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path bj:estensione ; sh:maxCount 1 ; sh:in ( "s" "ss" ) ] ,
                [ sh:path bj:qualificatore ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:mandaANota ; sh:class bj:Nota ] ,
                [ sh:path bj:mandaAMargine ; sh:class bj:Margine ] ,
                [ sh:path bj:interpretazione ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:regola ; sh:maxCount 1 ;
                  sh:in ( bj:regolaManuale bj:regolaAggiunta bj:regolaNumerazione bj:regolaRefuso bj:regolaCatena bj:regolaPuntatore bj:regolaCapitolo bj:regolaElenco bj:regolaInizio bj:regolaEster bj:regolaIntroduzione bj:regolaNudo bj:regolaLettura bj:regolaIndice bj:regolaProsa bj:regolaRimando bj:regolaPaginaEstranea bj:regolaNotaEditoriale bj:regolaParagrafo bj:regolaForma bj:regolaConversione ) ] ,
                [ sh:path bj:categoriaMotivo ; sh:maxCount 1 ;
                  sh:in ( bj:motivoExtracanonico bj:motivoFuoriIntervallo bj:motivoIntervalloErrato bj:motivoNonCompreso bj:motivoAltraNumerazione bj:motivoLibroAmbiguo bj:motivoAltro ) ] ,
                [ sh:path bj:secondoVersione ; sh:maxCount 1 ; sh:class bj:Versione ] ;
    sh:or ( [ sh:path bj:motivo ; sh:maxCount 0 ] [ sh:path bj:categoriaMotivo ; sh:minCount 1 ] ) ;
    sh:or ( [ sh:path bj:stato ; sh:in ( bj:irrisolto bj:nonRiferimento ) ]
            [ sh:path bj:aPassaggio ; sh:minCount 1 ]
            [ sh:path bj:libroCitato ; sh:minCount 1 ] ) ;
    sh:or ( [ sh:path bj:stato ; sh:in ( bj:risolto bj:nonRiferimento ) ]
            [ sh:path bj:motivo ; sh:minCount 1 ] ) .

bjf:Rimando a sh:NodeShape ;
    sh:targetClass bj:Rimando ;
    sh:property [ sh:path bj:daVersetto ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Versetto ] ,
                [ sh:path bj:nelMargine ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Margine ] ,
                [ sh:path bj:relazione ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( bj:correlato bj:parallelo bj:doppione bj:citatoDopo bj:numerazione bj:commento ) ] ,
                [ sh:path bj:posizione ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:segno ; sh:maxCount 1 ; sh:in ( "‖" "=" "/" ) ] ,
                [ sh:path bj:doppioneDelRimando ; sh:maxCount 1 ; sh:class bj:Rimando ] .

# A citation stands in exactly one note, one introduction or front-matter paragraph, one
# paragraph of a dictionary entry or one section title of an entry (those two with their
# entry), one chronology entry or one index entry; all but the index ones have their
# position in the text.
bjf:Citazione a sh:NodeShape ;
    sh:targetClass bj:Citazione ;
    sh:xone ( [ sh:path bj:daNota ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Nota ]
              [ sh:path bj:daParagrafo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Paragrafo ]
              [ sh:path bj:daEvento ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:EventoCronologia ]
              [ sh:path bj:daVoceIndice ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:VoceIndice ]
              [ sh:path bj:daVoceTavola ; sh:minCount 1 ; sh:maxCount 1 ]
              [ sh:property [ sh:path bj:daParagrafo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:ParagrafoVoce ] ,
                            [ sh:path bj:nellaVoce ; sh:minCount 1 ] ]
              [ sh:property [ sh:path bj:daSezione ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:SezioneVoce ] ,
                            [ sh:path bj:nellaVoce ; sh:minCount 1 ] ] ) ;
    sh:or ( [ sh:path bj:daVoceIndice ; sh:minCount 1 ]
            [ sh:path bj:daVoceTavola ; sh:minCount 1 ]
            [ sh:property [ sh:path bj:posizioneTesto ; sh:minCount 1 ] , [ sh:path bj:lunghezza ; sh:minCount 1 ] ,
                          [ sh:path bj:posizioneHtml ; sh:minCount 1 ] , [ sh:path bj:fineHtml ; sh:minCount 1 ] ] ) ;
    sh:property [ sh:path bj:posizioneTesto ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ,
                [ sh:path bj:lunghezza ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:posizioneHtml ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:fineHtml ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:conCf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path bj:indicaNota ; sh:class bj:Nota ] ,
                [ sh:path bj:corrispondenzaNota ; sh:maxCount 1 ; sh:in ( "nota" "copre" "capitolo" "rimandi" "nessuna" ) ] ,
                [ sh:path bj:seguito ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:aPassaggioCorretto ; sh:class bj:Passaggio ] ,
                [ sh:path bj:testoCorretto ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:correzione ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:nellaVoce ; sh:maxCount 1 ; sh:class bj:Voce ] ,
                [ sh:path bj:eAltrove ; sh:maxCount 1 ; sh:in ( true ) ] ,
                [ sh:path bj:libroImplicito ; sh:maxCount 1 ; sh:in ( 1 2 3 ) ] ,
                [ sh:path bj:conversione ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:tipoMotivo ; sh:maxCount 1 ;
                  sh:in ( "out-of-range" "ambiguous-book" "extra-canonical" "other" ) ] ,
                [ sh:path bj:statoFonte ; sh:maxCount 1 ; sh:in ( "out_of_range" "fixed" "noncanonical" "recovered" ) ] .

bjf:Passaggio a sh:NodeShape ;
    sh:targetClass bj:Passaggio ;
    sh:property [ sh:path bj:inizio ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Versetto ] ,
                [ sh:path bj:fine ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Versetto ] ,
                [ sh:path bj:comprende ; sh:minCount 1 ; sh:class bj:Versetto ] ,
                [ sh:path oa:hasSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Libro ] .

# ================================================================== the Dizionario di Teologia Biblica

# The work: a concept scheme with its bibliographic data, editors and translators.
bjf:Dizionario a sh:NodeShape ;
    sh:targetClass bj:Dizionario ;
    sh:class skos:ConceptScheme ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path dcterms:publisher ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path dcterms:issued ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:gYear ] ,
                [ sh:path bj:edizione ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:curatore ; sh:minCount 1 ; sh:class foaf:Person ] ,
                [ sh:path bj:traduttore ; sh:class foaf:Person ] ,
                [ sh:path skos:hasTopConcept ; sh:minCount 1 ; sh:class bj:Voce ] .

bjf:Persona a sh:NodeShape ;
    sh:targetClass foaf:Person ;
    sh:property [ sh:path foaf:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ,
                [ sh:path foaf:givenName ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path foaf:familyName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:ordineReligioso ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:sede ; sh:maxCount 1 ; sh:datatype xsd:string ] .

bjf:PaginaDizionario a sh:NodeShape ;
    sh:targetClass bj:PaginaDizionario ;
    sh:property [ sh:path bj:numero ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:paginaPdf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Dizionario ] .

# An entry: a SKOS concept of the dictionary's scheme with one Italian preferred label,
# printed on pages of the dictionary. A full entry has authors, a signature and a word
# count; a redirect entry has none of them.
bjf:Voce a sh:NodeShape ;
    sh:targetClass bj:Voce ;
    sh:class skos:Concept ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ;
                  sh:languageIn ( "it" ) ] ,
                [ sh:path skos:altLabel ; sh:datatype rdf:langString ] ,
                [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Dizionario ] ,
                [ sh:path skos:topConceptOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Dizionario ] ,
                [ sh:path dcterms:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[a-z0-9]+(-[a-z0-9]+)*$" ] ,
                [ sh:path bj:lettera ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[A-Z]$" ] ,
                [ sh:path bj:ordine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:paginaFinale ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:class bj:PaginaDizionario ] ,
                [ sh:path bj:testoRinvii ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ,
                [ sh:path dcterms:creator ; sh:class foaf:Person ] ,
                [ sh:path bj:firma ; sh:datatype xsd:string ] ,
                [ sh:path skos:related ; sh:class bj:Voce ] ,
                [ sh:path bj:richiamaVoce ; sh:class bj:Voce ] ,
                [ sh:path bj:vediAncheVoce ; sh:class bj:Voce ] ,
                [ sh:path bj:voceCitaVersetto ; sh:class bj:Versetto ] ;
    sh:xone ( [ sh:class bj:VoceRinvio ;
                sh:property [ sh:path dcterms:creator ; sh:maxCount 0 ] ,
                            [ sh:path bj:numeroParole ; sh:maxCount 0 ] ]
              [ sh:not [ sh:class bj:VoceRinvio ] ;
                sh:property [ sh:path dcterms:creator ; sh:minCount 1 ] ,
                            [ sh:path bj:firma ; sh:minCount 1 ] ,
                            [ sh:path bj:numeroParole ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ] ) .

bjf:VoceRinvio a sh:NodeShape ;
    sh:targetClass bj:VoceRinvio ;
    sh:property [ sh:path bj:rinviaAVoce ; sh:class bj:Voce ] .

bjf:SezioneVoce a sh:NodeShape ;
    sh:targetClass bj:SezioneVoce ;
    sh:property [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:or ( [ sh:class bj:SezioneVoce ] [ sh:class bj:Voce ] ) ] ,
                [ sh:path bj:nellaVoce ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Voce ] ,
                [ sh:path bj:percorso ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ,
                [ sh:path bj:tipoSezione ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "part" "testament" "roman" "num" "alpha" "runin" "caps" ) ] ,
                [ sh:path bj:livello ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 1 ; sh:maxInclusive 4 ] ,
                [ sh:path bj:ordine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path dcterms:title ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path bj:testoHtml ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:etichetta ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path dcterms:creator ; sh:class foaf:Person ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:PaginaDizionario ] .

bjf:ParagrafoVoce a sh:NodeShape ;
    sh:targetClass bj:ParagrafoVoce ;
    sh:property [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:or ( [ sh:class bj:SezioneVoce ] [ sh:class bj:Voce ] ) ] ,
                [ sh:path bj:nellaVoce ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Voce ] ,
                [ sh:path bj:testo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ;
                  sh:languageIn ( "it" ) ; sh:minLength 1 ] ,
                [ sh:path bj:testoHtml ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:numero ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:PaginaDizionario ] .

# A link between entries: its kind, the entry it is printed in and, when resolved, the
# entry it names (an unresolved one names none); a «*» word stands in a paragraph or a
# section title.
bjf:CollegamentoVoce a sh:NodeShape ;
    sh:targetClass bj:CollegamentoVoce ;
    sh:property [ sh:path bj:tipoCollegamento ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( bj:collegamentoAsterisco bj:collegamentoVediAnche bj:collegamentoRinvio ) ] ,
                [ sh:path bj:daVoce ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Voce ] ,
                [ sh:path bj:nellaVoce ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Voce ] ,
                [ sh:path bj:aVoce ; sh:maxCount 1 ; sh:class bj:Voce ] ,
                [ sh:path bj:aSezione ; sh:maxCount 1 ; sh:class bj:SezioneVoce ] ,
                [ sh:path bj:forma ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ,
                [ sh:path bj:percorso ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:metodo ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:esitoPercorso ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:daParagrafo ; sh:maxCount 1 ; sh:class bj:ParagrafoVoce ] ,
                [ sh:path bj:daSezione ; sh:maxCount 1 ; sh:class bj:SezioneVoce ] ;
    sh:xone ( [ sh:property [ sh:path bj:stato ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue bj:risolto ] ,
                            [ sh:path bj:aVoce ; sh:minCount 1 ] ]
              [ sh:property [ sh:path bj:stato ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue bj:irrisolto ] ,
                            [ sh:path bj:aVoce ; sh:maxCount 0 ] ] ) ;
    sh:or ( [ sh:path bj:tipoCollegamento ; sh:in ( bj:collegamentoVediAnche bj:collegamentoRinvio ) ]
            [ sh:path bj:daParagrafo ; sh:minCount 1 ]
            [ sh:path bj:daSezione ; sh:minCount 1 ] ) .

# ================================================================== the front matter and the appendices

# The edition: the work it prints, its imprint data and printings; printed pages of the
# front matter (Roman) and of the appendices.
bjf:Edizione a sh:NodeShape ;
    sh:targetClass bj:Edizione ;
    sh:property [ sh:path bj:edizioneDi ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Bibbia ] ,
                [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path dcterms:publisher ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path dcterms:issued ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:gYear ] ,
                [ sh:path bj:isbn ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^97[89]-[0-9-]+$" ] ,
                [ sh:path bj:direzioneEditoriale ; sh:class foaf:Person ] ,
                [ sh:path bj:curatore ; sh:class foaf:Person ] ,
                [ sh:path bj:imprimatur ; sh:minCount 1 ; sh:datatype xsd:string ] .

bjf:Stampa a sh:NodeShape ;
    sh:targetClass bj:Stampa ;
    sh:property [ sh:path bj:stampaDi ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Edizione ] ,
                [ sh:path bj:dataStampata ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path dcterms:date ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:gYearMonth ] ,
                [ sh:path bj:ordine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

bjf:PaginaParatesto a sh:NodeShape ;
    sh:targetClass bj:PaginaPreliminare , bj:PaginaAppendice ;
    sh:property [ sh:path bj:numero ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:paginaPdf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Edizione ] .

# A front-matter text: title, the edition, its pages; a signed one has its author, the
# signature and the lines under it.
bjf:TestoPreliminare a sh:NodeShape ;
    sh:targetClass bj:TestoPreliminare ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Edizione ] ,
                [ sh:path dcterms:creator ; sh:maxCount 1 ; sh:class foaf:Person ] ,
                [ sh:path bj:corsivo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:PaginaPreliminare ] ,
                [ sh:path bj:citaVersetto ; sh:class bj:Versetto ] ;
    sh:or ( [ sh:path dcterms:creator ; sh:maxCount 0 ]
            [ sh:property [ sh:path bj:firma ; sh:minCount 1 ; sh:maxCount 1 ] ,
                          [ sh:path bj:qualifica ; sh:minCount 1 ] ] ) .

bjf:Canone a sh:NodeShape ;
    sh:targetClass bj:Canone ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:TestoPreliminare ] .

bjf:GruppoCanone a sh:NodeShape ;
    sh:targetClass bj:GruppoCanone ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:or ( [ sh:class bj:Canone ] [ sh:class bj:GruppoCanone ] ) ] ,
                [ sh:path bj:ordine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

# A canon item names books or chapters of this Bible, unless it is an apocryphal book.
bjf:VoceCanone a sh:NodeShape ;
    sh:targetClass bj:VoceCanone ;
    sh:property [ sh:path bj:testo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:GruppoCanone ] ,
                [ sh:path bj:ordine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:comprendeLibro ; sh:class bj:Libro ] ,
                [ sh:path bj:comprendeCapitolo ; sh:class bj:Capitolo ] ,
                [ sh:path bj:deuterocanonico ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path bj:apocrifo ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:xone ( [ sh:path bj:apocrifo ; sh:hasValue true ]
              [ sh:or ( [ sh:path bj:comprendeLibro ; sh:minCount 1 ] [ sh:path bj:comprendeCapitolo ; sh:minCount 1 ] ) ] ) .

bjf:Abbreviazione a sh:NodeShape ;
    sh:targetClass bj:Abbreviazione ;
    sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ,
                [ sh:path bj:significato ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ;
                  sh:languageIn ( "it" ) ; sh:minLength 1 ] ,
                [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:languageIn ( "it" ) ] ,
                [ sh:path bj:abbreviaVersione ; sh:maxCount 1 ; sh:class bj:Versione ] ,
                [ sh:path bj:tipoAbbreviazione ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "libro" "libro-forma-antica" "abbreviazione" "segno" "codice-maiuscolo" "codice-minuscolo"
                          "papiro" "codice-vetus-latina" ) ] ,
                [ sh:path bj:abbreviaLibro ; sh:class bj:Libro ] ,
                [ sh:path bj:abbreviaManoscritto ; sh:maxCount 1 ; sh:class bj:Manoscritto ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

bjf:Manoscritto a sh:NodeShape ;
    sh:targetClass bj:Manoscritto ;
    sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:numeroGregoryAland ; sh:maxCount 1 ; sh:pattern "^(0[0-9]+|P[0-9]+|[1-9][0-9]*)$" ] ,
                [ sh:path bj:categoriaManoscritto ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "codice-maiuscolo" "codice-minuscolo" "papiro" "codice-vetus-latina" ) ] ,
                [ sh:path bj:descrizione ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

bjf:Xilografia a sh:NodeShape ;
    sh:targetClass bj:Xilografia ;
    sh:property [ sh:path bj:apreLibro ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Libro ] ,
                [ sh:path bj:illustra ; sh:minCount 1 ; sh:class bj:Passaggio ] ,
                [ sh:path bj:illustraVersetto ; sh:minCount 1 ; sh:class bj:Versetto ] .

# The indices: concept schemes of entries; a sub-entry has exactly one broader entry, an
# entry is a top concept; the links of an entry go to entries, verses, notes, introductions.
bjf:Indice a sh:NodeShape ;
    sh:targetClass bj:Indice ;
    sh:class skos:ConceptScheme ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path skos:hasTopConcept ; sh:minCount 1 ; sh:class bj:VoceIndice ] .

bjf:VoceIndice a sh:NodeShape ;
    sh:targetClass bj:VoceIndice ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ;
                  sh:languageIn ( "it" ) ] ,
                [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Indice ] ,
                [ sh:path skos:broader ; sh:maxCount 1 ; sh:class bj:VoceIndice ] ,
                [ sh:path skos:narrower ; sh:class bj:VoceIndice ] ,
                [ sh:path skos:related ; sh:class bj:VoceIndice ] ,
                [ sh:path bj:vediVoce ; sh:class bj:VoceIndice ] ,
                [ sh:path bj:indicaVersetto ; sh:class bj:Versetto ] ,
                [ sh:path bj:indicaNota ; sh:class bj:Nota ] ,
                [ sh:path bj:rinviaAIntroduzione ; sh:class bj:Introduzione ] ,
                [ sh:path bj:stile ; sh:maxCount 1 ; sh:in ( "maiuscoletto" "corsivo" "tondo" "grassetto" ) ] ,
                [ sh:path bj:ordine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:xone ( [ sh:property [ sh:path skos:broader ; sh:minCount 1 ] , [ sh:path skos:topConceptOf ; sh:maxCount 0 ] ,
                            [ sh:path bj:etichetta ; sh:minCount 1 ; sh:maxCount 1 ] ]
              [ sh:property [ sh:path skos:broader ; sh:maxCount 0 ] ,
                            [ sh:path skos:topConceptOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Indice ] ,
                            [ sh:path bj:stile ; sh:minCount 1 ] ] ) .

# The chronology: an entry is in one section and one column, with its text; a year range
# has both ends, in order.
bjf:TavolaCronologica a sh:NodeShape ;
    sh:targetClass bj:TavolaCronologica ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ] ,
                [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Edizione ] .

bjf:SezioneCronologia a sh:NodeShape ;
    sh:targetClass bj:SezioneCronologia ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ,
                [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:TavolaCronologica ] ,
                [ sh:path bj:ordine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:testo ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:minLength 1 ] ,
                [ sh:path bj:testoHtml ; sh:maxCount 1 ; sh:datatype xsd:string ] .

bjf:EventoCronologia a sh:NodeShape ;
    sh:targetClass bj:EventoCronologia ;
    sh:property [ sh:path bj:testo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:minLength 1 ] ,
                [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:SezioneCronologia ] ,
                [ sh:path bj:colonna ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( bj:colonnaUniversale bj:colonnaPalestina bj:colonnaIsraele bj:colonnaGiuda bj:colonnaEgitto
                          bj:colonnaLagidi bj:colonnaSeleucidi ) ] ,
                [ sh:path bj:riga ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:ordine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:anniMargine ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:datazione ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:citaVersetto ; sh:class bj:Versetto ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:PaginaAppendice ] ,
                # every entry is on the time line (bjf:LineaDelTempo: its years), dated by its own text or its row
                [ sh:path bj:posizioneLinea ; sh:minCount 1 ] ,
                [ sh:path bj:datataDa ; sh:minCount 1 ] ;
    # the date as printed when the entry has one (stage 2c, or the first date of its text), none when its row dates it
    sh:xone ( [ sh:property [ sh:path bj:datataDa ; sh:in ( "tavola" "testo" ) ] , [ sh:path bj:datazione ; sh:minCount 1 ] ]
              [ sh:property [ sh:path bj:datataDa ; sh:in ( "riga: anno a margine" "riga: date delle altre voci"
                                                            "riga: tra le voci della colonna" "riga: tra le righe vicine"
                                                            "periodo" "colonna: intestazione" ) ] ,
                            [ sh:path bj:datazione ; sh:maxCount 0 ] ] ) .

# The dynasties: persons of the chart with their family links.
bjf:TavolaGenealogica a sh:NodeShape ;
    sh:targetClass bj:TavolaGenealogica ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ] .

bjf:PersonaStorica a sh:NodeShape ;
    sh:targetClass bj:PersonaStorica ;
    sh:class schema:Person ;
    sh:property [ sh:path foaf:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ,
                [ sh:path dcterms:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:TavolaGenealogica ] ,
                [ sh:path schema:parent ; sh:maxCount 2 ; sh:class bj:PersonaStorica ] ,
                [ sh:path schema:children ; sh:class bj:PersonaStorica ] ,
                [ sh:path schema:spouse ; sh:class bj:PersonaStorica ] ,
                [ sh:path bj:numeroTavola ; sh:maxCount 1 ; sh:pattern "^[0-9]+[a-c]?$" ] ,
                [ sh:path bj:corsivo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path bj:datazione ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:tipoDatazione ; sh:maxCount 1 ; sh:in ( "morte" "regno" ) ] ;
    # a person with a date is on the time line, a death or a reign; one without, not
    sh:xone ( [ sh:property [ sh:path bj:datazione ; sh:minCount 1 ] , [ sh:path bj:posizioneLinea ; sh:minCount 1 ] ,
                            [ sh:path bj:tipoDatazione ; sh:minCount 1 ] ]
              [ sh:property [ sh:path bj:datazione ; sh:maxCount 0 ] , [ sh:path bj:posizioneLinea ; sh:maxCount 0 ] ,
                            [ sh:path bj:tipoDatazione ; sh:maxCount 0 ] ] ) .

# An acrostic letter: one of the 22 letters, its name without parentheses (the bracketed ones are
# flagged bj:mancanteNelTesto), the line it opens.
bjf:LetteraAcrostica a sh:NodeShape ;
    sh:targetClass bj:LetteraAcrostica ;
    sh:property [ sh:path bj:testo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[A-ZŚŠ][a-z]+$" ] ,
                [ sh:path bj:letteraEbraica ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[\u05D0-\u05EA]$" ] ,
                [ sh:path bj:posizioneAlfabeto ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 1 ; sh:maxInclusive 22 ] ,
                [ sh:path bj:rigo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:ordine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:mancanteNelTesto ; sh:maxCount 1 ; sh:in ( true ) ] ,
                [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:languageIn ( "it" ) ] ,
                [ sh:path bj:inVersetto ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Versetto ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

# ================================================================== session F2: identifiers, the links between the parts,
# the corrections, the calendar, the measures, the maps

# every typed resource but a textual body has its id of the JSON (R2-02)
bjf:Identificatore a sh:NodeShape ;
    sh:targetSubjectsOf rdf:type ;
    sh:or ( [ sh:class oa:TextualBody ]      # a body is named after its annotation
            [ sh:path dcterms:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ) .

bjf:Allineamento a sh:NodeShape ;
    sh:targetClass bj:Allineamento ;
    sh:property [ sh:path bj:allineamentoDa ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:VoceIndice ] ,
                [ sh:path bj:allineamentoA ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:or ( [ sh:class bj:Voce ] [ sh:class bj:VoceIndice ] ) ] ,
                [ sh:path bj:proprietaMapping ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( skos:closeMatch skos:broadMatch skos:narrowMatch skos:relatedMatch ) ] ,
                [ sh:path bj:metodoAllineamento ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "label" "stem" "altLabel" "rinvio" "head" "mano" "indici-label" "indici-head" "indici-parte"
                          "doppione" ) ] ,
                [ sh:path bj:revisore ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:versettiComuni ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ,
                [ sh:path bj:versettoComune ; sh:class bj:Versetto ] ,
                [ sh:path bj:tabellaFonte ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:rigaFonte ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

bjf:PersonaNominata a sh:NodeShape ;
    sh:targetSubjectsOf bj:nominaPersona ;
    sh:class bj:Versetto ;
    sh:property [ sh:path bj:nominaPersona ; sh:class bj:PersonaStorica ] .

bjf:Datazione a sh:NodeShape ;
    sh:targetClass bj:Datazione ;
    sh:property [ sh:path bj:datazioneDi ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:EventoCronologia ] ,
                [ sh:path bj:datazioneLibro ; sh:minCount 1 ; sh:class bj:Libro ] ,
                [ sh:path bj:tipoDatazione ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "composizione" "ministero" "evento" "citato" ) ] ;
    # a dating of a book is on the time line; a book only cited by the entry is not
    sh:xone ( [ sh:property [ sh:path bj:tipoDatazione ; sh:in ( "composizione" "ministero" "evento" ) ] ,
                            [ sh:path bj:posizioneLinea ; sh:minCount 1 ] ]
              [ sh:property [ sh:path bj:tipoDatazione ; sh:in ( "citato" ) ] , [ sh:path bj:posizioneLinea ; sh:maxCount 0 ] ] ) .

bjf:Versione a sh:NodeShape ;
    sh:targetClass bj:Versione ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:languageIn ( "it" ) ] .

bjf:Testimonianza a sh:NodeShape ;
    sh:targetSubjectsOf bj:citaTestimone ;
    sh:class bj:Nota ;
    sh:property [ sh:path bj:citaTestimone ; sh:or ( [ sh:class bj:Versione ] [ sh:class bj:Manoscritto ] ) ] .

bjf:Mese a sh:NodeShape ;
    sh:targetClass bj:Mese ;
    sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[IVX]+$" ] ,
                [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:languageIn ( "it" ) ] ,
                [ sh:path skos:inScheme ; sh:minCount 1 ; sh:class bj:Calendario ] ,
                [ sh:path bj:meseSolare ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[a-z]+/[a-z]+$" ] .

bjf:Festa a sh:NodeShape ;
    sh:targetClass bj:Festa ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:languageIn ( "it" ) ] ,
                [ sh:path bj:nelMese ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bj:Mese ] ,
                [ sh:path bj:citaVersetto ; sh:minCount 1 ; sh:class bj:Versetto ] .

bjf:Unita a sh:NodeShape ;
    sh:targetClass bj:Unita ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:languageIn ( "it" ) ] ,
                [ sh:path skos:altLabel ; sh:languageIn ( "he-Latn" "grc-Latn" "la" ) ] ,
                [ sh:path bj:tipoMisura ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "lunghezza" "capacita" "peso" "moneta" ) ] ,
                [ sh:path bj:valore ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minExclusive 0 ] ,
                [ sh:path bj:unitaQudt ; sh:maxCount 1 ;
                  sh:in ( <http://qudt.org/vocab/unit/CentiM> <http://qudt.org/vocab/unit/M> <http://qudt.org/vocab/unit/KiloM>
                          <http://qudt.org/vocab/unit/L> <http://qudt.org/vocab/unit/GM> <http://qudt.org/vocab/unit/KiloGM> ) ] ,
                [ sh:path bj:rapportoDecimale ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ,
                [ sh:path bj:rapportoA ; sh:maxCount 1 ; sh:class bj:Unita ] ,
                [ sh:path bj:equivaleA ; sh:class bj:Unita ] ,
                [ sh:path bj:pagina ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

bjf:Carta a sh:NodeShape ;
    sh:targetClass bj:Carta ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:languageIn ( "it" ) ] ,
                [ sh:path bj:paginaPdfCarta ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:immagine ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^progetti/.*\\.(png|jpg)$" ] ,
                [ sh:path bj:raffiguraLibro ; sh:minCount 1 ; sh:class bj:Libro ] ,
                [ sh:path bj:raffiguraPassaggio ; sh:class bj:Passaggio ] .

bjf:Intervento a sh:NodeShape ;
    sh:targetClass bj:Intervento ;
    sh:property [ sh:path oa:hasTarget ; sh:minCount 1 ] ,
                [ sh:path oa:motivatedBy ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( oa:editing oa:linking oa:describing bj:interpretando ) ] ,
                [ sh:path bj:regola ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( bj:regolaManuale bj:regolaAggiunta bj:regolaNumerazione bj:regolaRefuso bj:regolaCatena bj:regolaPuntatore bj:regolaCapitolo bj:regolaElenco bj:regolaInizio bj:regolaEster bj:regolaIntroduzione bj:regolaNudo bj:regolaLettura bj:regolaIndice bj:regolaProsa bj:regolaRimando bj:regolaPaginaEstranea bj:regolaNotaEditoriale bj:regolaParagrafo bj:regolaForma bj:regolaConversione ) ] ,
                [ sh:path oa:hasBody ; sh:maxCount 1 ; sh:class oa:TextualBody ] ,
                [ sh:path bj:tabellaFonte ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:rigaFonte ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:testoStampato ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:testoLetto ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:schemaNumerazione ; sh:maxCount 1 ; sh:class bj:SchemaNumerazione ] ,
                [ sh:path prov:wasDerivedFrom ; sh:maxCount 1 ;
                  sh:or ( [ sh:class bj:Pagina ] [ sh:class bj:PaginaAppendice ] ) ] ,
                [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class foaf:Person ] .

# quotations: the text between « and » (tools/ontologia/virgolette.py, F4)
bjf:Discorso a sh:NodeShape ;
    sh:targetClass bj:Discorso ;
    sh:property [ sh:path dcterms:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:languageIn ( "it" ) ] ,
                [ sh:path bj:parte ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "testo" "nota" "introduzione" "preliminari" "appendici" ) ] ,
                [ sh:path oa:hasSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path bj:iniziaIn ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path bj:finisceIn ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path bj:inizioCarattere ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ,
                [ sh:path bj:fineCarattere ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:dentroDi ; sh:maxCount 1 ; sh:class bj:Discorso ] ,
                [ sh:path bj:attraversa ; sh:class bj:Versetto ] ,
                [ sh:path bj:lunghezza ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ,
                [ sh:path bj:testo ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:maxLength 200 ] ,
                [ sh:path bj:sbilanciato ; sh:maxCount 1 ; sh:in ( true ) ] ,
                [ sh:path bj:motivo ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    # balanced: both ends and a length; unbalanced: its reason
    sh:or ( [ sh:property [ sh:path bj:iniziaIn ; sh:minCount 1 ] , [ sh:path bj:finisceIn ; sh:minCount 1 ] ,
                          [ sh:path bj:lunghezza ; sh:minCount 1 ] , [ sh:path bj:sbilanciato ; sh:maxCount 0 ] ]
            [ sh:property [ sh:path bj:sbilanciato ; sh:minCount 1 ] , [ sh:path bj:motivo ; sh:minCount 1 ] ] ) .

# ================================================================== the time line (stage 2f, eventi.py)

# every object of the time line: its place, years (start <= end), precision, era rule and the rest
bjf:LineaDelTempo a sh:NodeShape ;
    sh:targetSubjectsOf bj:posizioneLinea ;
    sh:or ( [ sh:class bj:EventoCronologia ] [ sh:class bj:EventoDatato ] [ sh:class bj:PersonaStorica ]
            [ sh:class bj:Datazione ] [ sh:class bj:Carta ] ) ;
    sh:property [ sh:path bj:posizioneLinea ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ,
                [ sh:path bj:annoInizio ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:lessThanOrEquals bj:annoFine ] ,
                [ sh:path bj:annoFine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:circa ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ,
                [ sh:path bj:precisione ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "anno" "intervallo" "circa" "secolo" "millennio" "riga" "periodo" ) ] ,
                [ sh:path bj:regolaEra ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ,
                [ sh:path bj:datataDa ; sh:maxCount 1 ;
                  sh:in ( "tavola" "testo" "riga: anno a margine" "riga: date delle altre voci"
                          "riga: tra le voci della colonna" "riga: tra le righe vicine" "periodo"
                          "colonna: intestazione" ) ] ,
                [ sh:path bj:limite ; sh:maxCount 1 ; sh:in ( "ante" "post" ) ] ,
                [ sh:path bj:incerto ; sh:maxCount 1 ; sh:in ( true ) ] ,
                [ sh:path bj:annoAlternativo ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
                [ sh:path bj:nelPeriodo ; sh:maxCount 1 ; sh:class bj:SezioneCronologia ] ,
                [ sh:path bj:stessoEvento ;
                  sh:or ( [ sh:class bj:EventoCronologia ] [ sh:class bj:EventoDatato ] [ sh:class bj:PersonaStorica ]
                          [ sh:class bj:Datazione ] [ sh:class bj:Carta ] ) ] .

# a date read in a note, an introduction, a front-matter text or a paragraph of the Dizionario: the expression
# and where it starts in its source, the sentence, its citations and their verses; a note's has its anchor verse
bjf:EventoDatato a sh:NodeShape ;
    sh:targetClass bj:EventoDatato ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:languageIn ( "it" ) ] ,
                [ sh:path bj:parte ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "nota" "introduzione" "preliminari" "dizionario" "tavola" ) ] ,
                [ sh:path oa:hasSource ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:or ( [ sh:class bj:Nota ] [ sh:class bj:Paragrafo ] [ sh:class bj:ParagrafoVoce ]
                          [ sh:class bj:SezioneCronologia ] ) ] ,
                [ sh:path bj:datazione ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ,
                [ sh:path bj:posizioneTesto ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ,
                [ sh:path bj:testo ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:minLength 1 ] ,
                [ sh:path bj:testoHtml ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path bj:posizioneLinea ; sh:minCount 1 ] ,
                [ sh:path bj:datataDa ; sh:maxCount 0 ] ,
                [ sh:path bj:citazioneNellaFrase ; sh:class bj:Citazione ] ,
                [ sh:path bj:citaVersetto ; sh:class bj:Versetto ] ,
                [ sh:path bj:versettoAncora ; sh:maxCount 1 ; sh:class bj:Versetto ] ;
    # the part says the kind of the source: a note (with its anchor verse), a paragraph of an introduction or of
    # the front matter, a paragraph of the Dizionario, a period of the chronological table (its line across the table)
    sh:xone ( [ sh:property [ sh:path bj:parte ; sh:in ( "nota" ) ] , [ sh:path bj:versettoAncora ; sh:minCount 1 ] ,
                            [ sh:path oa:hasSource ; sh:class bj:Nota ] ]
              [ sh:property [ sh:path bj:parte ; sh:in ( "introduzione" "preliminari" ) ] ,
                            [ sh:path bj:versettoAncora ; sh:maxCount 0 ] , [ sh:path oa:hasSource ; sh:class bj:Paragrafo ] ]
              [ sh:property [ sh:path bj:parte ; sh:in ( "dizionario" ) ] ,
                            [ sh:path bj:versettoAncora ; sh:maxCount 0 ] , [ sh:path oa:hasSource ; sh:class bj:ParagrafoVoce ] ]
              [ sh:property [ sh:path bj:parte ; sh:in ( "tavola" ) ] ,
                            [ sh:path bj:versettoAncora ; sh:maxCount 0 ] , [ sh:path oa:hasSource ; sh:class bj:SezioneCronologia ] ] ) .
