# Ontologia dei versetti della Bibbia di Gerusalemme (testo CEI 2008, note e rimandi
# a margine della Bible de Jérusalem). Vocabolario OWL 2 scritto a mano: i dati sono
# generati da tools/ontologia/rdf.py in ontologia/bj-dati.ttl.gz.
#
# The last section adds the Dizionario di Teologia Biblica (X. Léon-Dufour, 1976): its
# entries are SKOS concepts (bj:Voce) whose paragraphs cite verses through the same
# bj:Citazione / bj:Passaggio pattern as the BJ notes (shortcuts bj:voceCitaVersetto and
# bj:citatoNellaVoce).
#
# The verse (bj:Versetto) is the hub: notes (bj:Nota, W3C Web Annotations), margin
# references (bj:Rimando, reified, grouped in bj:Margine) and citations inside notes and
# introductions (bj:Citazione) all point from or to verses, through bj:Passaggio
# (a stretch of verses). Shortcut properties (bj:rimandaA, bj:haNota, bj:citaVersetto, ...)
# are materialised in the data for direct graph queries.

@prefix bj:      <https://massimo-nocentini.github.io/bibbia-gerusalemme/ontologia#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix oa:      <http://www.w3.org/ns/oa#> .
@prefix cito:    <http://purl.org/spar/cito/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .

<https://massimo-nocentini.github.io/bibbia-gerusalemme/ontologia>
    a owl:Ontology ;
    owl:versionInfo "1.0" ;
    dcterms:title "Ontologia dei versetti della Bibbia di Gerusalemme"@it ,
                  "Verse ontology of the Jerusalem Bible"@en ;
    rdfs:label "Ontologia dei versetti BJ"@it , "BJ verse ontology"@en ;
    rdfs:comment "Vocabolario centrato sul versetto per «La Bibbia di Gerusalemme» (EDB: testo CEI 2008, note e rimandi a margine della Bible de Jérusalem). Ogni versetto è collegato alle note che vi sono richiamate, alle note che lo commentano, ai rimandi stampati a margine e alle citazioni nelle note e nelle introduzioni."@it ,
                 "Verse-centred vocabulary for «La Bibbia di Gerusalemme» (EDB: CEI 2008 text, notes and marginal cross-references of the Bible de Jérusalem). Each verse is linked to the notes called from it, the notes commenting on it, the references printed in its margin and the citations inside notes and introductions."@en ;
    dcterms:creator "Massimo Nocentini" ;
    dcterms:source "progetti/<volume>/*.tex (14 volumi corretti / 14 proofread volumes)" ;
    vann:preferredNamespacePrefix "bj" ;
    vann:preferredNamespaceUri "https://massimo-nocentini.github.io/bibbia-gerusalemme/ontologia#" ;
    rdfs:seeAlso <https://www.w3.org/TR/annotation-vocab/> , <http://purl.org/spar/cito> .

# ------------------------------------------------------------------ external terms used

dcterms:isPartOf a owl:ObjectProperty .
oa:hasTarget a owl:ObjectProperty .
oa:hasBody a owl:ObjectProperty .
oa:hasSource a owl:ObjectProperty .
oa:motivatedBy a owl:ObjectProperty .
cito:cites a owl:ObjectProperty .
cito:hasCitingEntity a owl:ObjectProperty .
cito:hasCitedEntity a owl:ObjectProperty .
cito:isCitedBy a owl:ObjectProperty .
dcterms:creator a owl:ObjectProperty .
dcterms:contributor a owl:ObjectProperty .
skos:related a owl:ObjectProperty .
prov:wasDerivedFrom a owl:ObjectProperty .
oa:Annotation a owl:Class .
oa:SpecificResource a owl:Class .
oa:TextualBody a owl:Class .
cito:Citation a owl:Class .
skos:Concept a owl:Class .
skos:ConceptScheme a owl:Class .
foaf:Person a owl:Class .

# ------------------------------------------------------------------ classes

bj:Bibbia a owl:Class ;
    rdfs:label "Bibbia"@it , "Bible"@en ;
    rdfs:comment "L'intero volume della Bibbia di Gerusalemme."@it ,
                 "The whole volume of the Jerusalem Bible."@en .

bj:Testamento a owl:Class ;
    rdfs:label "Testamento"@it , "Testament"@en ;
    rdfs:comment "Antico o Nuovo Testamento; parte della Bibbia."@it ,
                 "Old or New Testament; part of the Bible."@en .

bj:Libro a owl:Class ;
    rdfs:label "Libro"@it , "Book"@en ;
    rdfs:comment "Un libro biblico come sezione del volume (74 sezioni: Ester compare due volte, testo greco e testo ebraico); identificato dal codice OSIS."@it ,
                 "A biblical book as a section of the volume (74 sections: Esther is printed twice, Greek and Hebrew text); identified by its OSIS code."@en .

bj:Capitolo a owl:Class ;
    rdfs:label "Capitolo"@it , "Chapter"@en ;
    rdfs:comment "Un capitolo di un libro; il prologo del Siracide è il capitolo 0 (etichetta «Prol»)."@it ,
                 "A chapter of a book; Sirach's prologue is chapter 0 (label «Prol»)."@en .

bj:Divisione a owl:Class ;
    rdfs:label "Divisione"@it , "Division"@en ;
    rdfs:comment "Una grande partizione di un libro (titolo \\parte: I., 1., A.), con il suo livello."@it ,
                 "A major division of a book (\\parte heading: I., 1., A.), with its level."@en .

bj:Pericope a owl:Class ;
    rdfs:label "Pericope"@it , "Pericope"@en ;
    rdfs:comment "Un brano con il suo titoletto (\\sezione), dal primo all'ultimo versetto."@it ,
                 "A passage with its heading (\\sezione), from its first to its last verse."@en .

bj:Versetto a owl:Class ;
    rdfs:label "Versetto"@it , "Verse"@en ;
    rdfs:comment "Il nodo centrale dell'ontologia: un versetto del testo CEI, con il suo testo, l'etichetta stampata, l'ordine canonico e la pagina."@it ,
                 "The central node of the ontology: a verse of the CEI text, with its text, printed label, canonical order and page."@en .

bj:Pagina a owl:Class ;
    rdfs:label "Pagina"@it , "Page"@en ;
    rdfs:comment "Una pagina stampata del volume (pagina del PDF = pagina + 33): la fonte da cui un versetto, una nota o un rimando è stato trascritto."@it ,
                 "A printed page of the volume (PDF page = page + 33): the source a verse, note or reference was transcribed from."@en .

bj:Introduzione a owl:Class ;
    rdfs:label "Introduzione"@it , "Introduction"@en ;
    rdfs:comment "Un'introduzione della BJ a un gruppo di libri o a un libro (prosa, senza versetti)."@it ,
                 "A BJ introduction to a group of books or to one book (prose, no verses)."@en .

bj:Paragrafo a owl:Class ;
    rdfs:label "Paragrafo"@it , "Paragraph"@en ;
    rdfs:comment "Un paragrafo di un'introduzione, eventualmente con un titoletto."@it ,
                 "A paragraph of an introduction, possibly with a run-in heading."@en .

bj:Nota a owl:Class ;
    rdfs:subClassOf oa:Annotation ;
    rdfs:label "Nota"@it , "Note"@en ;
    rdfs:comment "Una nota della BJ a piè di pagina: un'annotazione Web (oa:Annotation) il cui corpo è il testo della nota e il cui bersaglio sono i versetti (o il capitolo, o il libro) indicati dalla sua etichetta; è richiamata da un versetto (bj:richiamataDa)."@it ,
                 "A BJ footnote: a Web Annotation (oa:Annotation) whose body is the note text and whose target is the verses (or chapter, or book) named by its label; it is called from one verse (bj:richiamataDa)."@en .

bj:Margine a owl:Class ;
    rdfs:label "Margine"@it , "Margin entry"@en ;
    rdfs:comment "Un gruppo di rimandi stampato a margine accanto a una riga (un \\mref); contiene uno o più bj:Rimando separati da «;». È anche il «gruppo di rimandi» a cui può mandare un «+»."@it ,
                 "A group of references printed in the margin beside a line (one \\mref); it holds one or more bj:Rimando separated by «;». It is also the «group of references» a «+» may send to."@en .

bj:Rimando a owl:Class ;
    rdfs:subClassOf cito:Citation ;
    rdfs:label "Rimando"@it , "Cross-reference"@en ;
    rdfs:comment "Un singolo rimando a margine, reificato: dal versetto accanto a cui è stampato (bj:daVersetto) a un passaggio (bj:aPassaggio), con il testo stampato, la relazione (segno a margine), la nota chiave «+», i paralleli «p», il qualificatore e lo stato di risoluzione."@it ,
                 "One marginal cross-reference, reified: from the verse it is printed beside (bj:daVersetto) to a passage (bj:aPassaggio), with the printed text, the relation (margin sign), the key-note «+», the parallels «p», the qualifier and the resolution status."@en .

bj:Citazione a owl:Class ;
    rdfs:subClassOf cito:Citation ;
    rdfs:label "Citazione"@it , "Citation"@en ;
    rdfs:comment "Un riferimento biblico citato nel testo di una nota o di un paragrafo di introduzione, con la sua posizione nel testo."@it ,
                 "A biblical reference cited in the text of a note or of an introduction paragraph, with its position in the text."@en .

bj:Passaggio a owl:Class ;
    rdfs:subClassOf oa:SpecificResource ;
    rdfs:label "Passaggio"@it , "Passage"@en ;
    rdfs:comment "Un tratto di versetti consecutivi di un libro (in ordine numerico), dal versetto bj:inizio al versetto bj:fine; bj:comprende elenca ogni versetto. È una oa:SpecificResource il cui oa:hasSource è il libro. Un passaggio è identificato dai suoi estremi ed è condiviso da tutti i rimandi e le note che lo indicano."@it ,
                 "A stretch of consecutive verses of a book (in numeric order), from verse bj:inizio to verse bj:fine; bj:comprende lists every verse. It is an oa:SpecificResource whose oa:hasSource is the book. A passage is identified by its ends and shared by every reference and note naming it."@en .

bj:Relazione a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Relazione"@it , "Relation"@en ;
    rdfs:comment "Il tipo di un rimando a margine, dato dal segno stampato (nessun segno, ‖, =, ↗)."@it ,
                 "The kind of a marginal reference, given by its printed sign (no sign, ‖, =, ↗)."@en .

bj:Stato a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Stato"@it , "Status"@en ;
    rdfs:comment "L'esito della risoluzione di un riferimento verso i versetti."@it ,
                 "The outcome of resolving a reference to verses."@en .

bj:Ambito a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Ambito"@it , "Scope"@en ;
    rdfs:comment "Che cosa commenta una nota: versetti, capitoli interi o il libro."@it ,
                 "What a note comments on: verses, whole chapters or the book."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( bj:Bibbia bj:Testamento bj:Libro bj:Capitolo bj:Divisione bj:Pericope
                  bj:Versetto bj:Pagina bj:Introduzione bj:Paragrafo bj:Nota bj:Margine
                  bj:Rimando bj:Citazione bj:Passaggio
                  bj:Dizionario bj:Voce bj:SezioneVoce bj:ParagrafoVoce bj:CollegamentoVoce ) .

# ------------------------------------------------------------------ structure

bj:inLibro a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Versetto bj:Capitolo bj:Pericope bj:Divisione ) ] ;
    rdfs:range bj:Libro ;
    rdfs:label "nel libro"@it , "in book"@en ;
    rdfs:comment "Scorciatoia: il libro a cui appartiene un versetto, capitolo, pericope o divisione."@it ,
                 "Shortcut: the book a verse, chapter, pericope or division belongs to."@en .

bj:inPericope a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf dcterms:isPartOf ;
    rdfs:domain bj:Versetto ; rdfs:range bj:Pericope ;
    rdfs:label "nella pericope"@it , "in pericope"@en ;
    rdfs:comment "La pericope (brano con titolo) a cui appartiene il versetto; manca per i versetti stampati prima del primo titoletto."@it ,
                 "The pericope (headed passage) the verse belongs to; absent for verses printed before the first heading."@en .

bj:inDivisione a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf dcterms:isPartOf ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Pericope bj:Divisione ) ] ;
    rdfs:range bj:Divisione ;
    rdfs:label "nella divisione"@it , "in division"@en ;
    rdfs:comment "La divisione più interna che contiene una pericope, o la divisione madre di una divisione."@it ,
                 "The innermost division containing a pericope, or the parent division of a division."@en .

bj:precede a owl:ObjectProperty , owl:FunctionalProperty , owl:InverseFunctionalProperty ;
    owl:inverseOf bj:segue ;
    rdfs:domain bj:Versetto ; rdfs:range bj:Versetto ;
    rdfs:label "precede"@it , "precedes"@en ;
    rdfs:comment "Il versetto immediatamente successivo nell'ordine canonico del volume (anche attraverso capitoli e libri)."@it ,
                 "The next verse in the canonical order of the volume (also across chapters and books)."@en .

bj:segue a owl:ObjectProperty , owl:FunctionalProperty , owl:InverseFunctionalProperty ;
    rdfs:domain bj:Versetto ; rdfs:range bj:Versetto ;
    rdfs:label "segue"@it , "follows"@en ;
    rdfs:comment "Il versetto immediatamente precedente nell'ordine canonico (inversa di bj:precede)."@it ,
                 "The previous verse in canonical order (inverse of bj:precede)."@en .

bj:inizio a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Passaggio bj:Pericope bj:Divisione ) ] ;
    rdfs:range bj:Versetto ;
    rdfs:label "inizio"@it , "start"@en ;
    rdfs:comment "Il primo versetto di un passaggio, di una pericope o di una divisione."@it ,
                 "The first verse of a passage, pericope or division."@en .

bj:fine a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Passaggio bj:Pericope bj:Divisione ) ] ;
    rdfs:range bj:Versetto ;
    rdfs:label "fine"@it , "end"@en ;
    rdfs:comment "L'ultimo versetto di un passaggio, di una pericope o di una divisione."@it ,
                 "The last verse of a passage, pericope or division."@en .

bj:comprende a owl:ObjectProperty ;
    rdfs:domain bj:Passaggio ; rdfs:range bj:Versetto ;
    rdfs:label "comprende"@it , "includes"@en ;
    rdfs:comment "Ogni versetto di un passaggio, dall'inizio alla fine in ordine numerico."@it ,
                 "Every verse of a passage, from start to end in numeric order."@en .

bj:introduce a owl:ObjectProperty ;
    rdfs:domain bj:Introduzione ; rdfs:range bj:Libro ;
    rdfs:label "introduce"@it , "introduces"@en ;
    rdfs:comment "Un libro presentato dall'introduzione."@it ,
                 "A book the introduction presents."@en .

# ------------------------------------------------------------------ notes

bj:richiamataDa a owl:ObjectProperty , owl:FunctionalProperty ;
    owl:inverseOf bj:haNota ;
    rdfs:domain bj:Nota ; rdfs:range bj:Versetto ;
    rdfs:label "richiamata da"@it , "called from"@en ;
    rdfs:comment "Il versetto nel cui testo è stampato il richiamo della nota (dopo la prima parola della riga); per le note di capitolo, il primo versetto del capitolo."@it ,
                 "The verse whose text carries the note's call (after the first word of the line); for chapter notes, the first verse of the chapter."@en .

bj:haNota a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:domain bj:Versetto ; rdfs:range bj:Nota ;
    rdfs:label "ha nota"@it , "has note"@en ;
    rdfs:comment "Scorciatoia: una nota richiamata da questo versetto (inversa di bj:richiamataDa)."@it ,
                 "Shortcut: a note called from this verse (inverse of bj:richiamataDa)."@en .

bj:commenta a owl:ObjectProperty ;
    rdfs:subPropertyOf oa:hasTarget ;
    rdfs:domain bj:Nota ; rdfs:range bj:Versetto ;
    rdfs:label "commenta"@it , "comments on"@en ;
    rdfs:comment "Scorciatoia: ogni versetto indicato dall'etichetta della nota (passaggi e capitoli espansi). Il bersaglio vero e proprio della annotazione (oa:hasTarget) è il passaggio, il capitolo o il libro."@it ,
                 "Shortcut: every verse named by the note's label (passages and chapters expanded). The annotation's own target (oa:hasTarget) is the passage, chapter or book."@en .

bj:ambito a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Nota ; rdfs:range bj:Ambito ;
    rdfs:label "ambito"@it , "scope"@en ;
    rdfs:comment "Se la nota commenta versetti, capitoli interi o tutto il libro."@it ,
                 "Whether the note comments on verses, whole chapters or the whole book."@en .

# ------------------------------------------------------------------ margins and citations

bj:accantoA a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Margine ; rdfs:range bj:Versetto ;
    rdfs:label "accanto a"@it , "beside"@en ;
    rdfs:comment "Il versetto nel cui testo cade la prima parola della riga accanto a cui il margine è stampato; se quella riga comincia con le ultime parole (al più due) di un versetto e prosegue col successivo, il successivo (vedi bj:stampatoNelVersetto)."@it ,
                 "The verse whose text holds the first word of the line the margin entry is printed beside; when that line opens with the last words (two at most) of a verse and goes on with the next one, the next one (see bj:stampatoNelVersetto)."@en .

bj:stampatoNelVersetto a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Margine ; rdfs:range bj:Versetto ;
    rdfs:label "stampato nel versetto"@it , "printed within verse"@en ;
    rdfs:comment "Solo quando differisce da bj:accantoA: il versetto nel cui testo cade il richiamo del margine (dopo le sue ultime parole), mentre il margine è attribuito al versetto che comincia sulla stessa riga."@it ,
                 "Only when it differs from bj:accantoA: the verse whose text holds the margin call (after its last words), while the margin entry is assigned to the verse that begins on the same line."@en .

bj:nelMargine a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf dcterms:isPartOf ;
    rdfs:domain bj:Rimando ; rdfs:range bj:Margine ;
    rdfs:label "nel margine"@it , "in margin entry"@en ;
    rdfs:comment "Il gruppo di rimandi a margine di cui il rimando fa parte."@it ,
                 "The margin entry the reference is one item of."@en .

bj:daVersetto a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf cito:hasCitingEntity ;
    rdfs:domain bj:Rimando ; rdfs:range bj:Versetto ;
    rdfs:label "dal versetto"@it , "from verse"@en ;
    rdfs:comment "Il versetto accanto a cui il rimando è stampato (l'entità che cita)."@it ,
                 "The verse the reference is printed beside (the citing entity)."@en .

bj:daNota a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf cito:hasCitingEntity ;
    rdfs:domain bj:Citazione ; rdfs:range bj:Nota ;
    rdfs:label "dalla nota"@it , "from note"@en ;
    rdfs:comment "La nota nel cui testo compare la citazione."@it ,
                 "The note whose text contains the citation."@en .

bj:daParagrafo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf cito:hasCitingEntity ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Citazione bj:CollegamentoVoce ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( bj:Paragrafo bj:ParagrafoVoce ) ] ;
    rdfs:label "dal paragrafo"@it , "from paragraph"@en ;
    rdfs:comment "Il paragrafo nel cui testo compare la citazione: di un'introduzione della BJ o di una voce del Dizionario di Teologia Biblica (per una voce, anche la parola con «*» di un bj:CollegamentoVoce)."@it ,
                 "The paragraph whose text contains the citation: of a BJ introduction or of an entry of the Dizionario di Teologia Biblica (for an entry, also the «*» word of a bj:CollegamentoVoce)."@en .

bj:aPassaggio a owl:ObjectProperty ;
    rdfs:subPropertyOf cito:hasCitedEntity ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Rimando bj:Citazione ) ] ;
    rdfs:range bj:Passaggio ;
    rdfs:label "al passaggio"@it , "to passage"@en ;
    rdfs:comment "Un passaggio indicato dal rimando o dalla citazione (più d'uno quando il riferimento unisce versetti con «.», es. Dt 7,9.12)."@it ,
                 "A passage the reference or citation names (several when it joins verses with «.», e.g. Dt 7,9.12)."@en .

bj:libroCitato a owl:ObjectProperty ;
    rdfs:subPropertyOf cito:hasCitedEntity ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Rimando bj:Citazione ) ] ;
    rdfs:range bj:Libro ;
    rdfs:label "libro citato"@it , "cited book"@en ;
    rdfs:comment "Un libro citato nel suo insieme, es. «Gs (passim)»."@it ,
                 "A book cited as a whole, e.g. «Gs (passim)»."@en .

bj:relazione a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Rimando ; rdfs:range bj:Relazione ;
    rdfs:label "relazione"@it , "relation"@en ;
    rdfs:comment "Il tipo del rimando secondo il segno a margine (concetto SKOS dello schema bj:relazioni)."@it ,
                 "The kind of reference given by the margin sign (SKOS concept of the bj:relazioni scheme)."@en .

bj:stato a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Rimando bj:Citazione bj:CollegamentoVoce ) ] ;
    rdfs:range bj:Stato ;
    rdfs:label "stato"@it , "status"@en ;
    rdfs:comment "L'esito della risoluzione del riferimento (concetto dello schema bj:stati)."@it ,
                 "The outcome of resolving the reference (concept of the bj:stati scheme)."@en .

bj:mandaANota a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Rimando bj:Citazione ) ] ;
    rdfs:range bj:Nota ;
    rdfs:label "manda alla nota"@it , "sends to note"@en ;
    rdfs:comment "Per un riferimento con «+»: la nota chiave a cui manda (la più stretta che comincia in quel versetto, o vi è richiamata, o lo commenta)."@it ,
                 "For a reference with «+»: the key note it sends to (the narrowest starting at that verse, or called from it, or commenting on it)."@en .

bj:doppioneDelRimando a owl:ObjectProperty ;
    rdfs:domain bj:Rimando ; rdfs:range bj:Rimando ;
    rdfs:label "doppione del rimando"@it , "doublet of reference"@en ;
    rdfs:comment "Segno «=» legato al riferimento precedente dello stesso margine («‖2Cr 1,14=9,25», «‖Lc 8,16; =11,33»): questo passaggio è il doppione di quello del rimando precedente; il versetto a margine vi è collegato con la relazione del rimando precedente."@it ,
                 "Sign «=» tied to the previous reference of the same margin entry («‖2Cr 1,14=9,25», «‖Lc 8,16; =11,33»): this passage is the doublet of the previous reference's one; the verse in the margin relates to it with the previous reference's relation."@en .

bj:interpretazione a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Rimando bj:Citazione ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "interpretazione"@it , "reading"@en ;
    rdfs:comment "Per un riferimento senza sigla che non esiste nel libro ereditato: la lettura con cui è stato risolto (il libro corrente, l'ultimo libro nominato nel testo, versetti del capitolo precedente). Nel dizionario anche: il libro in vigore prima di un inciso «cfr.», il libro nominato nella prosa, una scelta a mano, il libro di una citazione recuperata dal testo."@it ,
                 "For a reference without siglum that does not exist in the book it inherits: the reading that resolved it (the current book, the last book named in the text, verses of the previous chapter). In the dictionary also: the book in force before a «cfr.» aside, the book named in the prose, a choice by hand, the book of a citation recovered from the text."@en .

bj:mandaAMargine a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Rimando bj:Citazione ) ] ;
    rdfs:range bj:Margine ;
    rdfs:label "manda al margine"@it , "sends to margin entry"@en ;
    rdfs:comment "Per un riferimento con «+» senza nota in quel versetto: il gruppo di rimandi stampato accanto a esso."@it ,
                 "For a reference with «+» and no note at that verse: the group of references printed beside it."@en .

# ------------------------------------------------------------------ shortcuts between verses

bj:rimandaA a owl:ObjectProperty ;
    rdfs:domain bj:Versetto ; rdfs:range bj:Versetto ;
    rdfs:label "rimanda a"@it , "refers to"@en ;
    rdfs:comment "Scorciatoia materializzata: il versetto ha a margine un rimando a un passaggio che comprende l'altro versetto (qualunque segno). Contiene anche le sue sottoproprietà e il verso inverso dei paralleli e dei doppioni, che sono simmetrici."@it ,
                 "Materialised shortcut: the verse has a margin reference to a passage including the other verse (any sign). It also holds its subproperties and the reverse direction of parallels and doublets, which are symmetric."@en .

bj:paralleloA a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:subPropertyOf bj:rimandaA ;
    rdfs:domain bj:Versetto ; rdfs:range bj:Versetto ;
    rdfs:label "parallelo a"@it , "parallel to"@en ;
    rdfs:comment "Segno «‖»: parallelo letterario in un altro libro (es. Samuele-Re e Cronache, vangeli sinottici)."@it ,
                 "Sign «‖»: literary parallel in another book (e.g. Samuel-Kings and Chronicles, the synoptic gospels)."@en .

bj:doppioneDi a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:subPropertyOf bj:rimandaA ;
    rdfs:domain bj:Versetto ; rdfs:range bj:Versetto ;
    rdfs:label "doppione di"@it , "doublet of"@en ;
    rdfs:comment "Segno «=»: doppione nello stesso libro (o nello stesso testo)."@it ,
                 "Sign «=»: doublet in the same book (or the same text)."@en .

bj:citatoIn a owl:ObjectProperty ;
    rdfs:subPropertyOf bj:rimandaA ;
    rdfs:domain bj:Versetto ; rdfs:range bj:Versetto ;
    rdfs:label "citato in"@it , "quoted in"@en ;
    rdfs:comment "Segno «↗» (stampato «/» nei sorgenti): questo versetto è citato o ripreso in un libro posteriore (per lo più nel NT)."@it ,
                 "Sign «↗» (typed «/» in the sources): this verse is quoted or used in a later book (mostly the NT)."@en .

bj:rinviaANotaChiave a owl:ObjectProperty ;
    rdfs:subPropertyOf bj:rimandaA ;
    rdfs:domain bj:Versetto ; rdfs:range bj:Versetto ;
    rdfs:label "rinvia a nota chiave"@it , "refers to key note at"@en ;
    rdfs:comment "Segno «+» dopo il riferimento: nel versetto indicato si trova una nota chiave o un gruppo di rimandi (vedi bj:mandaANota, bj:mandaAMargine)."@it ,
                 "Sign «+» after the reference: the verse named holds a key note or a group of references (see bj:mandaANota, bj:mandaAMargine)."@en .

bj:citaVersetto a owl:ObjectProperty ;
    rdfs:subPropertyOf cito:cites ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Nota bj:Introduzione ) ] ;
    rdfs:range bj:Versetto ;
    rdfs:label "cita il versetto"@it , "cites verse"@en ;
    rdfs:comment "Scorciatoia: la nota o l'introduzione cita nel suo testo un passaggio che comprende il versetto (riassume le bj:Citazione risolte)."@it ,
                 "Shortcut: the note or introduction cites in its text a passage including the verse (sums up the resolved bj:Citazione)."@en .

bj:proprietaDiretta a owl:AnnotationProperty ;
    rdfs:label "proprietà diretta"@it , "direct property"@en ;
    rdfs:comment "Collega un concetto di relazione alla scorciatoia tra versetti che lo materializza, o un tipo di collegamento tra voci alla scorciatoia tra voci."@it ,
                 "Links a relation concept to the verse-to-verse shortcut that materialises it, or a kind of link between entries to the entry-to-entry shortcut."@en .

# ------------------------------------------------------------------ data properties

bj:testo a owl:DatatypeProperty ;
    rdfs:label "testo"@it , "text"@en ;
    rdfs:comment "Il testo semplice (senza marcatura): di un versetto o paragrafo (in italiano, «a capo» \\n a fine riga poetica), o di un riferimento come stampato."@it ,
                 "The plain text (no markup): of a verse or paragraph (Italian, \\n at poetry line ends), or of a reference as printed."@en .

bj:testoHtml a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "testo HTML"@it , "HTML text"@en ;
    rdfs:comment "Il testo con la marcatura minima in HTML (<em>, <br>, <strong>)."@it ,
                 "The text with minimal HTML markup (<em>, <br>, <strong>)."@en .

bj:etichetta a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "etichetta"@it , "label as printed"@en ;
    rdfs:comment "L'etichetta come stampata: numero del versetto (es. «8a»; «25,19» per Nm 25,19, stampato in Nm 26), del capitolo, o etichetta della nota (es. «1,1–2,4a», «c 4»), o di una sezione di una voce del dizionario («II», «2», «b»)."@it ,
                 "The label as printed: verse number (e.g. «8a»; «25,19» for Nm 25,19, printed in Nm 26), chapter number, or note label (e.g. «1,1–2,4a», «c 4»), or of a section of a dictionary entry («II», «2», «b»)."@en .

bj:numero a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "numero"@it , "number"@en ;
    rdfs:comment "Il numero (senza lettere) di un versetto, capitolo, pagina o paragrafo."@it ,
                 "The number (without letters) of a verse, chapter, page or paragraph."@en .

bj:suffisso a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Versetto ; rdfs:range xsd:string ;
    rdfs:label "suffisso"@it , "suffix"@en ;
    rdfs:comment "La lettera di un versetto stampato in parti (Ester greco 1,1a; Is 7,8a)."@it ,
                 "The letter of a verse printed in parts (Greek Esther 1,1a; Isa 7,8a)."@en .

bj:numeroCapitolo a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Versetto ; rdfs:range xsd:integer ;
    rdfs:label "numero del capitolo"@it , "chapter number"@en ;
    rdfs:comment "Scorciatoia: il numero del capitolo del versetto (0 = prologo del Siracide)."@it ,
                 "Shortcut: the verse's chapter number (0 = Sirach's prologue)."@en .

bj:ordine a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "ordine"@it , "order"@en ;
    rdfs:comment "La posizione nell'ordine canonico (stampato) del volume, da 1; per il dizionario, la posizione di una voce nel volume o di una sezione nella sua voce."@it ,
                 "The position in the canonical (printed) order of the volume, from 1; in the dictionary, the position of an entry in the volume or of a section in its entry."@en .

bj:pagina a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "pagina"@it , "page"@en ;
    rdfs:comment "Il numero della pagina stampata (della BJ: pagina del PDF = pagina + 33; del dizionario: + 21); la pagina stessa è prov:wasDerivedFrom. Per una voce del dizionario, la prima pagina."@it ,
                 "The printed page number (of the BJ: PDF page = page + 33; of the dictionary: + 21); the page itself is prov:wasDerivedFrom. For a dictionary entry, its first page."@en .

bj:paginaPdf a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Pagina ; rdfs:range xsd:integer ;
    rdfs:label "pagina del PDF"@it , "PDF page"@en ;
    rdfs:comment "Il numero di pagina nel PDF della scansione (pagina stampata + 33)."@it ,
                 "The page number in the scanned PDF (printed page + 33)."@en .

bj:poesia a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Versetto ; rdfs:range xsd:boolean ;
    rdfs:label "poesia"@it , "poetry"@en ;
    rdfs:comment "Vero se il versetto è stampato in versi (ambiente poesia)."@it ,
                 "True if the verse is printed as poetry."@en .

bj:omesso a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Versetto ; rdfs:range xsd:boolean ;
    rdfs:label "omesso"@it , "omitted"@en ;
    rdfs:comment "Vero se il numero del versetto è stampato ma la CEI ne omette il testo (es. Mt 17,21)."@it ,
                 "True if the verse number is printed but the CEI omits its text (e.g. Mt 17,21)."@en .

bj:traParentesi a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Versetto ; rdfs:range xsd:boolean ;
    rdfs:label "tra parentesi"@it , "bracketed"@en ;
    rdfs:comment "Vero se il versetto è stampato tra parentesi quadre (Ester greco 4,6; 9,5)."@it ,
                 "True if the verse is printed in square brackets (Greek Esther 4,6; 9,5)."@en .

bj:stampatoNelCapitolo a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Versetto ; rdfs:range xsd:integer ;
    rdfs:label "stampato nel capitolo"@it , "printed in chapter"@en ;
    rdfs:comment "Il capitolo in cui un versetto fuori posto è stampato (Nm 25,19, stampato all'inizio di Nm 26)."@it ,
                 "The chapter a displaced verse is printed in (Nm 25,19, printed at the top of Nm 26)."@en .

bj:titoloSalmo a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Versetto ; rdfs:range rdf:langString ;
    rdfs:label "titolo del salmo"@it , "psalm title"@en ;
    rdfs:comment "Il titolo (soprascritta) di un salmo, tolto dal testo del versetto che lo contiene."@it ,
                 "A psalm's title (superscription), taken out of the text of the verse holding it."@en .

bj:acrostico a owl:DatatypeProperty ;
    rdfs:domain bj:Versetto ; rdfs:range xsd:string ;
    rdfs:label "lettera acrostica"@it , "acrostic letter"@en ;
    rdfs:comment "Una lettera ebraica dell'acrostico che apre il versetto (Salmi, Pr 31); due quando il versetto ne apre due strofe."@it ,
                 "A Hebrew acrostic letter heading the verse (Psalms, Pr 31); two when the verse opens two stanzas."@en .

bj:sigla a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Libro ; rdfs:range xsd:string ;
    rdfs:label "sigla"@it , "siglum"@en ;
    rdfs:comment "La sigla CEI del libro, usata nei rimandi e nelle note (Gen, Es, Sal, Mt, ...); «Est» vale per entrambi i testi di Ester."@it ,
                 "The CEI siglum of the book, used in the references and notes (Gen, Es, Sal, Mt, ...); «Est» stands for both Esther texts."@en .

bj:codiceOsis a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Libro ; rdfs:range xsd:string ;
    rdfs:label "codice OSIS"@it , "OSIS code"@en ;
    rdfs:comment "Il codice OSIS del libro (Gen, Exod, Ps, John, ...); EsthGr per il testo greco di Ester (non standard)."@it ,
                 "The OSIS code of the book (Gen, Exod, Ps, John, ...); EsthGr for the Greek text of Esther (not standard)."@en .

bj:volume a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:string ;
    rdfs:label "volume"@it , "volume"@en ;
    rdfs:comment "Il progetto LaTeX (volume corretto) da cui il libro o l'introduzione è stato estratto (es. pentateuco)."@it ,
                 "The LaTeX project (proofread volume) the book or introduction was extracted from (e.g. pentateuco)."@en .

bj:titoloBreve a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range rdf:langString ;
    rdfs:label "titolo breve"@it , "short title"@en ;
    rdfs:comment "Il titolo breve usato nelle testatine, quando è diverso dal titolo."@it ,
                 "The short title used in running heads, when different from the title."@en .

bj:livello a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Divisione bj:SezioneVoce ) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "livello"@it , "level"@en ;
    rdfs:comment "Il livello di una divisione: 1 = I., 2 = 1., 3 = A.; di una sezione di una voce del dizionario: la profondità, da 1."@it ,
                 "The level of a division: 1 = I., 2 = 1., 3 = A.; of a section of a dictionary entry: its depth, from 1."@en .

bj:apreCapitolo a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Pericope ; rdfs:range xsd:integer ;
    rdfs:label "apre il capitolo"@it , "opens chapter"@en ;
    rdfs:comment "Il capitolo che il titoletto della pericope apre, se ne apre uno."@it ,
                 "The chapter the pericope heading opens, if any."@en .

bj:dentroVersetto a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Pericope ; rdfs:range xsd:boolean ;
    rdfs:label "dentro un versetto"@it , "inside a verse"@en ;
    rdfs:comment "Vero se il titoletto è stampato in mezzo a un versetto (es. Gen 2,4b)."@it ,
                 "True if the heading is printed inside a verse (e.g. Gen 2,4b)."@en .

bj:segno a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:string ;
    rdfs:label "segno"@it , "sign"@en ;
    rdfs:comment "Il segno stampato: «‖», «=», «/» (↗) davanti a un rimando; «•» davanti all'etichetta di alcune note di Ester."@it ,
                 "The printed sign: «‖», «=», «/» (↗) before a reference; «•» before the label of some Esther notes."@en .

bj:posizione a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "posizione"@it , "position"@en ;
    rdfs:comment "La posizione (da 1) di un margine tra quelli dello stesso versetto, o di un rimando nel suo margine."@it ,
                 "The position (from 1) of a margin entry among those of its verse, or of a reference inside its margin entry."@en .

bj:posizioneTesto a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "posizione nel testo"@it , "text offset"@en ;
    rdfs:comment "Posizione (in caratteri, da 0) nel testo semplice: del richiamo di una nota o margine nel testo del versetto, o di una citazione nel testo della nota o del paragrafo."@it ,
                 "Character offset (from 0) in the plain text: of a note or margin call in the verse text, or of a citation in the note or paragraph text."@en .

bj:posizioneHtml a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "posizione nell'HTML"@it , "HTML offset"@en ;
    rdfs:comment "Come bj:posizioneTesto, ma nel testo HTML (mai dentro un tag)."@it ,
                 "As bj:posizioneTesto, but in the HTML text (never inside a tag)."@en .

bj:fineHtml a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Citazione ; rdfs:range xsd:integer ;
    rdfs:label "fine nell'HTML"@it , "HTML end"@en ;
    rdfs:comment "Dove finisce la citazione nel testo HTML (posizione esclusa)."@it ,
                 "Where the citation ends in the HTML text (exclusive offset)."@en .

bj:lunghezza a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Citazione ; rdfs:range xsd:integer ;
    rdfs:label "lunghezza"@it , "length"@en ;
    rdfs:comment "La lunghezza in caratteri della citazione nel testo semplice."@it ,
                 "The length in characters of the citation in the plain text."@en .

bj:parolaPrecedente a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:string ;
    rdfs:label "parola precedente"@it , "preceding word"@en ;
    rdfs:comment "La parola dopo cui è stampato il richiamo di una nota o di un margine."@it ,
                 "The word the call of a note or margin entry is printed after."@en .

bj:conCf a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Citazione ; rdfs:range xsd:boolean ;
    rdfs:label "con cf."@it , "with cf."@en ;
    rdfs:comment "Vero se la citazione è preceduta da «cf.»."@it ,
                 "True if the citation is preceded by «cf.»."@en .

bj:notaChiave a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Rimando bj:Citazione ) ] ;
    rdfs:range xsd:boolean ;
    rdfs:label "nota chiave"@it , "key note"@en ;
    rdfs:comment "Vero se il riferimento porta «+»: là si trova una nota chiave o un gruppo di rimandi."@it ,
                 "True if the reference carries «+»: a key note or a group of references is found there."@en .

bj:conParalleli a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Rimando bj:Citazione ) ] ;
    rdfs:range xsd:boolean ;
    rdfs:label "con i paralleli"@it , "with parallels"@en ;
    rdfs:comment "Vero se il riferimento porta «p»: il passaggio e i suoi paralleli (sinottici)."@it ,
                 "True if the reference carries «p»: the passage and its (synoptic) parallels."@en .

bj:estensione a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Rimando bj:Citazione ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "estensione"@it , "extension"@en ;
    rdfs:comment "«s» (e il versetto seguente) o «ss» (e seguenti, fino alla fine della pericope); già espansa nel passaggio."@it ,
                 "«s» (and the next verse) or «ss» (and following, to the end of the pericope); already expanded in the passage."@en .

bj:qualificatore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Rimando bj:Citazione ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "qualificatore"@it , "qualifier"@en ;
    rdfs:comment "La tradizione testuale o di numerazione indicata: LXX, volg., TM, TM var., Tg."@it ,
                 "The text or numbering tradition named: LXX, volg., TM, TM var., Tg."@en .

bj:numeroAlternativo a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Rimando bj:Citazione ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "numero alternativo"@it , "alternative number"@en ;
    rdfs:comment "Un'altra numerazione stampata con il riferimento (es. «3,96(29)»), o il numero di un rimando di numerazione."@it ,
                 "Another numbering printed with the reference (e.g. «3,96(29)»), or the number of a numbering entry."@en .

bj:motivo a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Rimando bj:Citazione ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "motivo"@it , "reason"@en ;
    rdfs:comment "Perché il riferimento non è (del tutto) risolto (es. «no verse 2Mac 12,46»); i refusi restano come stampati."@it ,
                 "Why the reference is not (fully) resolved (e.g. «no verse 2Mac 12,46»); misprints are kept as printed."@en .

bj:titoletto a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Paragrafo ; rdfs:range rdf:langString ;
    rdfs:label "titoletto"@it , "run-in heading"@en ;
    rdfs:comment "Il titoletto in grassetto che apre il paragrafo."@it ,
                 "The bold run-in heading opening the paragraph."@en .

bj:intestazione a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Introduzione ; rdfs:range xsd:string ;
    rdfs:label "intestazione"@it , "heading"@en ;
    rdfs:comment "L'intestazione dell'introduzione come stampata (maiuscolo)."@it ,
                 "The introduction heading as printed (upper case)."@en .

# ------------------------------------------------------------------ SKOS: relations of the margins

bj:relazioni a skos:ConceptScheme ;
    rdfs:label "Relazioni dei rimandi a margine"@it , "Relations of the marginal references"@en ;
    rdfs:comment "I segni dei rimandi a margine, come li definisce la presentazione della BJ."@it ,
                 "The signs of the marginal references, as the BJ front matter defines them."@en ;
    skos:hasTopConcept bj:correlato , bj:parallelo , bj:doppione , bj:citatoDopo , bj:numerazione , bj:commento .

bj:correlato a skos:Concept , bj:Relazione ;
    skos:inScheme bj:relazioni ; skos:topConceptOf bj:relazioni ;
    skos:prefLabel "da confrontare"@it , "related"@en ;
    rdfs:label "da confrontare"@it , "related"@en ;
    rdfs:comment "Nessun segno: un passo che è utile confrontare."@it ,
                 "No sign: a passage usefully compared."@en ;
    bj:proprietaDiretta bj:rimandaA .

bj:parallelo a skos:Concept , bj:Relazione ;
    skos:inScheme bj:relazioni ; skos:topConceptOf bj:relazioni ;
    skos:notation "‖" ;
    skos:prefLabel "parallelo"@it , "parallel"@en ;
    rdfs:label "parallelo"@it , "parallel"@en ;
    rdfs:comment "«‖»: parallelo letterario in un altro libro."@it ,
                 "«‖»: literary parallel in another book."@en ;
    bj:proprietaDiretta bj:paralleloA .

bj:doppione a skos:Concept , bj:Relazione ;
    skos:inScheme bj:relazioni ; skos:topConceptOf bj:relazioni ;
    skos:notation "=" ;
    skos:prefLabel "doppione"@it , "doublet"@en ;
    rdfs:label "doppione"@it , "doublet"@en ;
    rdfs:comment "«=»: doppione nello stesso libro."@it ,
                 "«=»: doublet in the same book."@en ;
    bj:proprietaDiretta bj:doppioneDi .

bj:citatoDopo a skos:Concept , bj:Relazione ;
    skos:inScheme bj:relazioni ; skos:topConceptOf bj:relazioni ;
    skos:notation "↗" , "/" ;
    skos:prefLabel "citato in un libro posteriore"@it , "quoted later"@en ;
    rdfs:label "citato in un libro posteriore"@it , "quoted later"@en ;
    rdfs:comment "«↗» (scritto «/» nei sorgenti): il passo è citato o ripreso in un libro posteriore, per lo più nel NT."@it ,
                 "«↗» (typed «/» in the sources): the passage is quoted or used in a later book, mostly the NT."@en ;
    bj:proprietaDiretta bj:citatoIn .

bj:numerazione a skos:Concept , bj:Relazione ;
    skos:inScheme bj:relazioni ; skos:topConceptOf bj:relazioni ;
    skos:prefLabel "altra numerazione"@it , "numbering"@en ;
    rdfs:label "altra numerazione"@it , "numbering"@en ;
    rdfs:comment "Non è un rimando: il margine stampa il numero di questo versetto o capitolo in un'altra tradizione (Volgata, LXX, TM)."@it ,
                 "Not a reference: the margin prints this verse's or chapter's number in another tradition (Vulgate, LXX, TM)."@en .

bj:commento a skos:Concept , bj:Relazione ;
    skos:inScheme bj:relazioni ; skos:topConceptOf bj:relazioni ;
    skos:prefLabel "osservazione"@it , "comment"@en ;
    rdfs:label "osservazione"@it , "comment"@en ;
    rdfs:comment "Non è un rimando: un'osservazione a margine, es. «(aramaico)»."@it ,
                 "Not a reference: a remark in the margin, e.g. «(aramaico)»."@en .

# ------------------------------------------------------------------ SKOS: resolution status

bj:stati a skos:ConceptScheme ;
    rdfs:label "Stati di risoluzione"@it , "Resolution statuses"@en ;
    rdfs:comment "L'esito della risoluzione di un riferimento stampato verso i versetti."@it ,
                 "The outcome of resolving a printed reference to verses."@en ;
    skos:hasTopConcept bj:risolto , bj:parziale , bj:irrisolto , bj:nonRiferimento .

bj:risolto a skos:Concept , bj:Stato ;
    skos:inScheme bj:stati ; skos:topConceptOf bj:stati ;
    skos:prefLabel "risolto"@it , "resolved"@en ;
    rdfs:label "risolto"@it , "resolved"@en ;
    rdfs:comment "Ogni versetto indicato esiste."@it , "Every verse named exists."@en .

bj:parziale a skos:Concept , bj:Stato ;
    skos:inScheme bj:stati ; skos:topConceptOf bj:stati ;
    skos:prefLabel "parziale"@it , "partial"@en ;
    rdfs:label "parziale"@it , "partial"@en ;
    rdfs:comment "Solo una parte dei versetti indicati esiste (es. un intervallo che supera la fine del capitolo)."@it ,
                 "Only part of the verses named exists (e.g. a range past the end of the chapter)."@en .

bj:irrisolto a skos:Concept , bj:Stato ;
    skos:inScheme bj:stati ; skos:topConceptOf bj:stati ;
    skos:prefLabel "irrisolto"@it , "unresolved"@en ;
    rdfs:label "irrisolto"@it , "unresolved"@en ;
    rdfs:comment "Il riferimento non porta ad alcun versetto: refuso, altra numerazione, libro non canonico; bj:motivo dice perché."@it ,
                 "The reference leads to no verse: misprint, other numbering, non-canonical book; bj:motivo says why."@en .

bj:nonRiferimento a skos:Concept , bj:Stato ;
    skos:inScheme bj:stati ; skos:topConceptOf bj:stati ;
    skos:prefLabel "non è un riferimento"@it , "not a reference"@en ;
    rdfs:label "non è un riferimento"@it , "not a reference"@en ;
    rdfs:comment "Un numero di un'altra tradizione o un'osservazione: non c'è nulla da risolvere."@it ,
                 "A number of another tradition or a remark: nothing to resolve."@en .

# ------------------------------------------------------------------ SKOS: scope of a note

bj:ambiti a skos:ConceptScheme ;
    rdfs:label "Ambiti delle note"@it , "Note scopes"@en ;
    rdfs:comment "Che cosa commenta una nota, secondo la sua etichetta."@it ,
                 "What a note comments on, according to its label."@en ;
    skos:hasTopConcept bj:ambitoVersetti , bj:ambitoCapitolo , bj:ambitoLibro .

bj:ambitoVersetti a skos:Concept , bj:Ambito ;
    skos:inScheme bj:ambiti ; skos:topConceptOf bj:ambiti ;
    skos:prefLabel "versetti"@it , "verses"@en ;
    rdfs:label "versetti"@it , "verses"@en ;
    rdfs:comment "Etichetta «1,2», «1,2–5», «1,1–2,4a», «v 6», ecc.: il bersaglio è uno o più passaggi."@it ,
                 "Label «1,2», «1,2–5», «1,1–2,4a», «v 6», etc.: the target is one or more passages."@en .

bj:ambitoCapitolo a skos:Concept , bj:Ambito ;
    skos:inScheme bj:ambiti ; skos:topConceptOf bj:ambiti ;
    skos:prefLabel "capitoli"@it , "chapters"@en ;
    rdfs:label "capitoli"@it , "chapters"@en ;
    rdfs:comment "Etichetta «c 2», «cc 8–10», o il numero di un salmo: il bersaglio sono capitoli interi."@it ,
                 "Label «c 2», «cc 8–10», or a psalm number: the target is whole chapters."@en .

bj:ambitoLibro a skos:Concept , bj:Ambito ;
    skos:inScheme bj:ambiti ; skos:topConceptOf bj:ambiti ;
    skos:prefLabel "libro"@it , "book"@en ;
    rdfs:label "libro"@it , "book"@en ;
    rdfs:comment "«Nota introduttiva»: il bersaglio è il libro intero."@it ,
                 "«Nota introduttiva»: the target is the whole book."@en .

# ================================================================== the Dizionario di Teologia Biblica
#
# X. Léon-Dufour (ed.), Dizionario di Teologia Biblica (Marietti, 5th Italian edition 1976),
# read from ../dufour/corpus by tools/ontologia/dufour.py. The work is a bj:Dizionario and
# also the skos:ConceptScheme of its entries; each entry (bj:Voce) is a skos:Concept and
# the article written about it: sections (bj:SezioneVoce) and paragraphs (bj:ParagrafoVoce)
# hang off it with dcterms:isPartOf. Every Bible reference printed in a paragraph (or a
# section title) is a bj:Citazione to bj:Passaggio, as in the BJ notes; the shortcuts
# bj:voceCitaVersetto / bj:citatoNellaVoce join entries and verses directly. Links between
# entries («*word», «→» lists) are reified (bj:CollegamentoVoce) and materialised as
# subproperties of skos:related.

# ------------------------------------------------------------------ classes

bj:Dizionario a owl:Class ;
    rdfs:label "Dizionario"@it , "Dictionary"@en ;
    rdfs:comment "Un dizionario biblico come opera: i suoi dati bibliografici (dcterms), i curatori e i traduttori; è anche lo schema di concetti (skos:ConceptScheme) delle sue voci."@it ,
                 "A biblical dictionary as a work: its bibliographic data (dcterms), editors and translators; it is also the concept scheme (skos:ConceptScheme) of its entries."@en .

bj:Voce a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Voce"@it , "Entry"@en ;
    rdfs:comment "Una voce (una «parola») del dizionario: il concetto nominato dal lemma (skos:prefLabel), collegato alle altre voci (skos:related e sottoproprietà), e insieme l'articolo scritto su di esso, con autori (dcterms:creator), pagine, sezioni e paragrafi. Le voci di solo rinvio sono bj:VoceRinvio."@it ,
                 "An entry (a «word») of the dictionary: the concept named by the headword (skos:prefLabel), linked to the other entries (skos:related and subproperties), and at the same time the article written about it, with authors (dcterms:creator), pages, sections and paragraphs. Entries that only send elsewhere are bj:VoceRinvio."@en .

bj:VoceRinvio a owl:Class ;
    rdfs:subClassOf bj:Voce ;
    rdfs:label "Voce di rinvio"@it , "Redirect entry"@en ;
    rdfs:comment "Una voce senza testo: il lemma seguito da «→» e dalle voci (con le sezioni) a cui rinvia (bj:rinviaAVoce). Quando rinvia a una sola voce, il suo lemma è anche skos:altLabel di quella."@it ,
                 "An entry without text: the headword followed by «→» and the entries (with their sections) it sends to (bj:rinviaAVoce). When it sends to one entry only, its headword is also an skos:altLabel of that entry."@en .

bj:SezioneVoce a owl:Class ;
    rdfs:label "Sezione di una voce"@it , "Entry section"@en ;
    rdfs:comment "Una sezione di una voce con il suo titolo, nella notazione del libro (bj:percorso «VT I 2», «B NT III 2», «introd.»); dcterms:isPartOf la sezione madre o la voce."@it ,
                 "A section of an entry with its title, in the book's notation (bj:percorso «VT I 2», «B NT III 2», «introd.»); dcterms:isPartOf the parent section or the entry."@en .

bj:ParagrafoVoce a owl:Class ;
    rdfs:label "Paragrafo di una voce"@it , "Entry paragraph"@en ;
    rdfs:comment "Un paragrafo del testo di una voce (bj:testo senza «*», bj:testoHtml con il corsivo e i collegamenti alle voci); dcterms:isPartOf la sua sezione, o la voce per i paragrafi prima del primo titolo."@it ,
                 "A paragraph of an entry's text (bj:testo without «*», bj:testoHtml with italics and links to entries); dcterms:isPartOf its section, or the entry for paragraphs before the first heading."@en .

bj:CollegamentoVoce a owl:Class ;
    rdfs:subClassOf cito:Citation ;
    rdfs:label "Collegamento tra voci"@it , "Entry link"@en ;
    rdfs:comment "Un collegamento stampato da una voce a un'altra, reificato: una parola con «*» nel testo (dal paragrafo o dal titolo di sezione in cui sta), una voce dell'elenco «→» finale (vedi anche) o di una voce di rinvio, con la sezione indicata; il tipo è un concetto dello schema bj:tipiCollegamento."@it ,
                 "A printed link from an entry to another, reified: a «*» word in the text (from the paragraph or section title it stands in), an item of the closing «→» list (see also) or of a redirect entry, with the section it names; the kind is a concept of the bj:tipiCollegamento scheme."@en .

bj:PaginaDizionario a owl:Class ;
    rdfs:subClassOf bj:Pagina ;
    rdfs:label "Pagina del dizionario"@it , "Dictionary page"@en ;
    rdfs:comment "Una pagina stampata del dizionario (pagina del PDF, contata da 1 = pagina + 21; l'indice da 0 del corpus Dufour è pagina + 20); dcterms:isPartOf il dizionario."@it ,
                 "A printed page of the dictionary (PDF page, counted from 1 = page + 21; the 0-based index of the Dufour corpus is page + 20); dcterms:isPartOf the dictionary."@en .

bj:TipoCollegamento a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Tipo di collegamento"@it , "Link kind"@en ;
    rdfs:comment "Il tipo di un collegamento tra voci: parola con «*», vedi anche, rinvio."@it ,
                 "The kind of a link between entries: «*» word, see also, redirect."@en .

# ------------------------------------------------------------------ structure of the dictionary

bj:nellaVoce a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:SezioneVoce bj:ParagrafoVoce bj:Citazione bj:CollegamentoVoce ) ] ;
    rdfs:range bj:Voce ;
    rdfs:label "nella voce"@it , "in entry"@en ;
    rdfs:comment "Scorciatoia: la voce a cui appartiene una sezione, un paragrafo, una citazione o un collegamento (come bj:inLibro per i versetti)."@it ,
                 "Shortcut: the entry a section, paragraph, citation or link belongs to (as bj:inLibro for verses)."@en .

bj:daSezione a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf cito:hasCitingEntity ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:Citazione bj:CollegamentoVoce ) ] ;
    rdfs:range bj:SezioneVoce ;
    rdfs:label "dalla sezione"@it , "from section"@en ;
    rdfs:comment "La sezione nel cui titolo compare la citazione o la parola con «*» (quando non è in un paragrafo)."@it ,
                 "The section whose title contains the citation or the «*» word (when it is not in a paragraph)."@en .

bj:curatore a owl:ObjectProperty ;
    rdfs:subPropertyOf dcterms:contributor ;
    rdfs:domain bj:Dizionario ; rdfs:range foaf:Person ;
    rdfs:label "curatore"@it , "editor"@en ;
    rdfs:comment "Chi ha diretto l'opera («pubblicato sotto la direzione di»)."@it ,
                 "Who directed the work («published under the direction of»)."@en .

bj:traduttore a owl:ObjectProperty ;
    rdfs:subPropertyOf dcterms:contributor ;
    rdfs:domain bj:Dizionario ; rdfs:range foaf:Person ;
    rdfs:label "traduttore"@it , "translator"@en ;
    rdfs:comment "Chi ha curato l'edizione italiana."@it ,
                 "Who edited the Italian edition."@en .

# ------------------------------------------------------------------ links between entries

bj:daVoce a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf cito:hasCitingEntity ;
    rdfs:domain bj:CollegamentoVoce ; rdfs:range bj:Voce ;
    rdfs:label "dalla voce"@it , "from entry"@en ;
    rdfs:comment "La voce in cui il collegamento è stampato."@it ,
                 "The entry the link is printed in."@en .

bj:aVoce a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf cito:hasCitedEntity ;
    rdfs:domain bj:CollegamentoVoce ; rdfs:range bj:Voce ;
    rdfs:label "alla voce"@it , "to entry"@en ;
    rdfs:comment "La voce indicata dal collegamento (manca se non è stata trovata: bj:stato bj:irrisolto)."@it ,
                 "The entry the link names (absent when it was not found: bj:stato bj:irrisolto)."@en .

bj:aSezione a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf cito:hasCitedEntity ;
    rdfs:domain bj:CollegamentoVoce ; rdfs:range bj:SezioneVoce ;
    rdfs:label "alla sezione"@it , "to section"@en ;
    rdfs:comment "Per un rinvio o un «vedi anche» con un percorso («VT I 2»): la sezione della voce di arrivo che esso indica."@it ,
                 "For a redirect or «see also» item with a path («VT I 2»): the section of the target entry it names."@en .

bj:tipoCollegamento a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain bj:CollegamentoVoce ; rdfs:range bj:TipoCollegamento ;
    rdfs:label "tipo di collegamento"@it , "link kind"@en ;
    rdfs:comment "Parola con «*», vedi anche, rinvio (concetto dello schema bj:tipiCollegamento)."@it ,
                 "«*» word, see also, redirect (concept of the bj:tipiCollegamento scheme)."@en .

bj:richiamaVoce a owl:ObjectProperty ;
    rdfs:subPropertyOf skos:related ;
    rdfs:domain bj:Voce ; rdfs:range bj:Voce ;
    rdfs:label "richiama la voce"@it , "stars entry"@en ;
    rdfs:comment "Scorciatoia: il testo della voce contiene una parola con «*» che rimanda all'altra voce (esclusa la voce stessa)."@it ,
                 "Shortcut: the entry's text holds a «*» word sending to the other entry (the entry itself excluded)."@en .

bj:vediAncheVoce a owl:ObjectProperty ;
    rdfs:subPropertyOf skos:related ;
    rdfs:domain bj:Voce ; rdfs:range bj:Voce ;
    rdfs:label "vedi anche"@it , "see also"@en ;
    rdfs:comment "Scorciatoia: l'altra voce è nell'elenco «→» che chiude la voce."@it ,
                 "Shortcut: the other entry is in the «→» list closing the entry."@en .

bj:rinviaAVoce a owl:ObjectProperty ;
    rdfs:subPropertyOf skos:related ;
    rdfs:domain bj:VoceRinvio ; rdfs:range bj:Voce ;
    rdfs:label "rinvia alla voce"@it , "redirects to"@en ;
    rdfs:comment "Scorciatoia: la voce di rinvio manda all'altra voce."@it ,
                 "Shortcut: the redirect entry sends to the other entry."@en .

# ------------------------------------------------------------------ entries and verses

bj:voceCitaVersetto a owl:ObjectProperty ;
    rdfs:subPropertyOf cito:cites ;
    owl:inverseOf bj:citatoNellaVoce ;
    rdfs:domain bj:Voce ; rdfs:range bj:Versetto ;
    rdfs:label "la voce cita il versetto"@it , "entry cites verse"@en ;
    rdfs:comment "Scorciatoia: un paragrafo o un titolo della voce cita un passaggio che comprende il versetto (riassume le bj:Citazione risolte o parziali della voce)."@it ,
                 "Shortcut: a paragraph or title of the entry cites a passage including the verse (sums up the entry's resolved or partial bj:Citazione)."@en .

bj:citatoNellaVoce a owl:ObjectProperty ;
    rdfs:subPropertyOf cito:isCitedBy ;
    rdfs:domain bj:Versetto ; rdfs:range bj:Voce ;
    rdfs:label "citato nella voce"@it , "cited in entry"@en ;
    rdfs:comment "Scorciatoia: il versetto è citato nella voce del dizionario (inversa di bj:voceCitaVersetto, materializzata)."@it ,
                 "Shortcut: the verse is cited in the dictionary entry (inverse of bj:voceCitaVersetto, materialised)."@en .

# ------------------------------------------------------------------ data properties of the dictionary

bj:edizione a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Dizionario ; rdfs:range xsd:string ;
    rdfs:label "edizione"@it , "edition"@en ;
    rdfs:comment "L'edizione come stampata nel frontespizio."@it ,
                 "The edition as printed on the title page."@en .

bj:lettera a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Voce ; rdfs:range xsd:string ;
    rdfs:label "lettera"@it , "letter"@en ;
    rdfs:comment "La lettera dell'alfabeto sotto cui la voce è stampata."@it ,
                 "The letter of the alphabet the entry is printed under."@en .

bj:paginaFinale a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Voce ; rdfs:range xsd:integer ;
    rdfs:label "pagina finale"@it , "last page"@en ;
    rdfs:comment "L'ultima pagina stampata della voce (la prima è bj:pagina)."@it ,
                 "The last printed page of the entry (the first is bj:pagina)."@en .

bj:numeroParole a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Voce ; rdfs:range xsd:integer ;
    rdfs:label "numero di parole"@it , "word count"@en ;
    rdfs:comment "Le parole del testo della voce (dal corpus Dufour)."@it ,
                 "The words of the entry's text (from the Dufour corpus)."@en .

bj:firma a owl:DatatypeProperty ;
    rdfs:domain bj:Voce ; rdfs:range xsd:string ;
    rdfs:label "firma"@it , "signature"@en ;
    rdfs:comment "La firma stampata in fondo alla voce («P. GRELOT», «R. FEUILLET e A. VIARD»); gli autori sono dcterms:creator. Una voce firmata per parti (NOME: VT e NT) ha due firme, e ogni parte ha il suo dcterms:creator."@it ,
                 "The signature printed at the end of the entry («P. GRELOT», «R. FEUILLET e A. VIARD»); the authors are dcterms:creator. An entry signed part by part (NOME: VT and NT) has two signatures, and each part has its own dcterms:creator."@en .

bj:testoRinvii a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Voce ; rdfs:range xsd:string ;
    rdfs:label "rinvii stampati"@it , "printed cross-references"@en ;
    rdfs:comment "L'elenco «→» come stampato: il «vedi anche» di una voce o i rinvii di una voce di rinvio."@it ,
                 "The «→» list as printed: the «see also» of an entry or the targets of a redirect entry."@en .

bj:percorso a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( bj:SezioneVoce bj:CollegamentoVoce ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "percorso"@it , "path"@en ;
    rdfs:comment "Il percorso di una sezione nella notazione del libro («VT I 2», «B NT III 2», «introd.»), o quello stampato in un rinvio."@it ,
                 "The path of a section in the book's notation («VT I 2», «B NT III 2», «introd.»), or the one printed in a cross-reference."@en .

bj:tipoSezione a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:SezioneVoce ; rdfs:range xsd:string ;
    rdfs:label "tipo di sezione"@it , "section kind"@en ;
    rdfs:comment "Come è stampato il titolo: part (A.), testament (VT/NT), roman (I.), num (1.), alpha (a), runin, caps."@it ,
                 "How the heading is printed: part (A.), testament (VT/NT), roman (I.), num (1.), alpha (a), runin, caps."@en .

bj:forma a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:CollegamentoVoce ; rdfs:range xsd:string ;
    rdfs:label "forma"@it , "form"@en ;
    rdfs:comment "La parola o il lemma come stampato nel collegamento («*sofferente» per SOFFERENZA)."@it ,
                 "The word or headword as printed in the link («*sofferente» for SOFFERENZA)."@en .

bj:metodo a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:CollegamentoVoce ; rdfs:range xsd:string ;
    rdfs:label "metodo"@it , "method"@en ;
    rdfs:comment "Per una parola con «*»: come il corpus Dufour l'ha ricondotta alla voce (exact, lemma, stem, manual, ...)."@it ,
                 "For a «*» word: how the Dufour corpus matched it to the entry (exact, lemma, stem, manual, ...)."@en .

bj:esitoPercorso a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:CollegamentoVoce ; rdfs:range xsd:string ;
    rdfs:label "esito del percorso"@it , "path status"@en ;
    rdfs:comment "Per un rinvio con percorso: come il corpus Dufour l'ha trovato nella voce di arrivo (exact, swap, testament, split, none, unresolved, no-target)."@it ,
                 "For a cross-reference with a path: how the Dufour corpus found it in the target entry (exact, swap, testament, split, none, unresolved, no-target)."@en .

bj:eAltrove a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Citazione ; rdfs:range xsd:boolean ;
    rdfs:label "e altrove"@it , "and elsewhere"@en ;
    rdfs:comment "Vero se la citazione del dizionario è seguita da «...» (e altrove); assente altrimenti."@it ,
                 "True if the dictionary citation is followed by «...» (and elsewhere); absent otherwise."@en .

bj:libroImplicito a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Citazione ; rdfs:range xsd:integer ;
    rdfs:label "libro implicito"@it , "implicit book"@en ;
    rdfs:comment "Per una citazione del dizionario senza sigla: 1 il libro è ereditato dalla citazione precedente, 2 è nominato nel testo, 3 è quello del paragrafo precedente (una citazione recuperata dal testo); assente se la sigla è stampata."@it ,
                 "For a dictionary citation without siglum: 1 the book is inherited from the previous citation, 2 it is named in the text, 3 it is the one of the paragraph before (a citation recovered from the text); absent when the siglum is printed."@en .

bj:conversione a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Citazione ; rdfs:range xsd:string ;
    rdfs:label "conversione"@it , "conversion"@en ;
    rdfs:comment "Come una riga di biblerefs.tsv è stata riletta dal testo (lettere di Ester greco, «s» attaccata al versetto, Abdia stampato «Ab», un intervallo tra capitoli diviso dalla fonte, la vecchia divisione dei versetti di Siracide 34-36, correzioni a mano)."@it ,
                 "How a row of biblerefs.tsv was read again from the text (letters of Greek Esther, an «s» glued to the verse, Obadiah printed «Ab», a range across chapters the source split, the older verse division of Sirach 34-36, corrections by hand)."@en .

bj:tipoMotivo a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Citazione ; rdfs:range xsd:string ;
    rdfs:label "tipo di motivo"@it , "reason kind"@en ;
    rdfs:comment "Per una citazione del dizionario non risolta o parziale: out-of-range (capitolo o versetto inesistente), ambiguous-book, extra-canonical, other."@it ,
                 "For an unresolved or partial dictionary citation: out-of-range (no such chapter or verse), ambiguous-book, extra-canonical, other."@en .

bj:statoFonte a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain bj:Citazione ; rdfs:range xsd:string ;
    rdfs:label "stato nella fonte"@it , "source status"@en ;
    rdfs:comment "Lo stato della riga in biblerefs.tsv del corpus Dufour, quando non è «ok» (out_of_range, fixed, noncanonical), o recovered per una citazione che la fonte non ha collegato, recuperata dal testo."@it ,
                 "The status of the row in biblerefs.tsv of the Dufour corpus, when not «ok» (out_of_range, fixed, noncanonical), or recovered for a citation the source did not link, recovered from the text."@en .

bj:ordineReligioso a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain foaf:Person ; rdfs:range xsd:string ;
    rdfs:label "ordine religioso"@it , "religious order"@en ;
    rdfs:comment "La sigla dell'ordine o istituto di un collaboratore come stampata («O.P», «S.J»)."@it ,
                 "The order or institute of a collaborator as printed («O.P», «S.J»)."@en .

bj:sede a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain foaf:Person ; rdfs:range xsd:string ;
    rdfs:label "sede"@it , "place"@en ;
    rdfs:comment "La città di un collaboratore come stampata nell'elenco dei collaboratori."@it ,
                 "A collaborator's city as printed in the list of collaborators."@en .

# ------------------------------------------------------------------ SKOS: kinds of links between entries

bj:tipiCollegamento a skos:ConceptScheme ;
    rdfs:label "Tipi di collegamento tra voci"@it , "Kinds of links between entries"@en ;
    rdfs:comment "I modi in cui una voce del dizionario manda a un'altra."@it ,
                 "The ways an entry of the dictionary sends to another."@en ;
    skos:hasTopConcept bj:collegamentoAsterisco , bj:collegamentoVediAnche , bj:collegamentoRinvio .

bj:collegamentoAsterisco a skos:Concept , bj:TipoCollegamento ;
    skos:inScheme bj:tipiCollegamento ; skos:topConceptOf bj:tipiCollegamento ;
    skos:notation "*" ;
    skos:prefLabel "parola con asterisco"@it , "starred word"@en ;
    rdfs:label "parola con asterisco"@it , "starred word"@en ;
    rdfs:comment "«*parola» nel testo: la parola ha una voce propria (anche flessa: «*pasti» → PASTO)."@it ,
                 "«*word» in the text: the word has an entry of its own (also inflected: «*pasti» → PASTO)."@en ;
    bj:proprietaDiretta bj:richiamaVoce .

bj:collegamentoVediAnche a skos:Concept , bj:TipoCollegamento ;
    skos:inScheme bj:tipiCollegamento ; skos:topConceptOf bj:tipiCollegamento ;
    skos:notation "→" ;
    skos:prefLabel "vedi anche"@it , "see also"@en ;
    rdfs:label "vedi anche"@it , "see also"@en ;
    rdfs:comment "Una voce, con le sue sezioni, dell'elenco «→» che chiude una voce."@it ,
                 "An entry, with its sections, of the «→» list closing an entry."@en ;
    bj:proprietaDiretta bj:vediAncheVoce .

bj:collegamentoRinvio a skos:Concept , bj:TipoCollegamento ;
    skos:inScheme bj:tipiCollegamento ; skos:topConceptOf bj:tipiCollegamento ;
    skos:notation "→" ;
