# I Salmi citati nel NT (↗), per libro del NT.
# Psalms quoted in the NT (↗), by NT book.
PREFIX bj: <https://massimo-nocentini.github.io/bibbia-gerusalemme/ontologia#>
PREFIX verso: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/verso/>
PREFIX libro: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/libro/>
PREFIX testamento: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/testamento/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX oa: <http://www.w3.org/ns/oa#>

SELECT ?libro_nt ?rimandi ?salmi ?quali WHERE {
  {
    SELECT ?libro_nt ?o (COUNT(DISTINCT ?r) AS ?rimandi) (COUNT(DISTINCT ?salmo) AS ?salmi)
           (GROUP_CONCAT(DISTINCT ?salmo; separator=" ") AS ?quali) WHERE {
      ?r bj:relazione bj:citatoDopo ; bj:daVersetto ?v ; bj:aPassaggio ?p .
      ?v bj:inLibro ?lv ; bj:numeroCapitolo ?salmo .
      ?p bj:inizio ?pi .
      ?pi bj:inLibro ?l .
      ?l dcterms:isPartOf ?t ; rdfs:label ?libro_nt ; bj:ordine ?o .
      FILTER (?lv = libro:Ps && ?t = testamento:NT)
    }
    GROUP BY ?libro_nt ?o
  }
}
ORDER BY ?o
