# Passi dell'AT citati o ripresi nel NT (segno ↗ a margine).
# OT passages quoted or used later in the NT (margin sign ↗, typed "/").
PREFIX bj: <https://massimo-nocentini.github.io/bibbia-gerusalemme/ontologia#>
PREFIX verso: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/verso/>
PREFIX libro: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/libro/>
PREFIX testamento: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/testamento/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX oa: <http://www.w3.org/ns/oa#>

SELECT ?versetto_at ?come_stampato ?passo_nt WHERE {
  ?r bj:relazione bj:citatoDopo ; bj:daVersetto ?v ; bj:testo ?come_stampato ; bj:aPassaggio ?p .
  ?v bj:inLibro ?lv ; rdfs:label ?versetto_at ; bj:ordine ?o .
  ?lv dcterms:isPartOf ?tv .
  ?p bj:inizio ?pi ; rdfs:label ?passo_nt .
  ?pi bj:inLibro ?lp ; bj:ordine ?op .
  ?lp dcterms:isPartOf ?tp .
  FILTER (?tv = testamento:AT && ?tp = testamento:NT)
}
ORDER BY ?o ?op
