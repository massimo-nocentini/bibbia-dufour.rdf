# Le correzioni e le letture del curatore in un solo modello (bj:Intervento, un oa:Annotation): per tabella
# e regola, quanti interventi, con la motivazione e un esempio con il suo motivo.
# The editor's corrections and readings in one model: by table and rule, how many, the motivation, an example.
PREFIX bj: <https://massimo-nocentini.github.io/bibbia-gerusalemme/ontologia#>
PREFIX verso: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/verso/>
PREFIX libro: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/libro/>
PREFIX indice: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/indice/>
PREFIX voce: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/voce/>
PREFIX cronologia: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/cronologia/>
PREFIX dinastia: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/dinastia/>
PREFIX manoscritto: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/manoscritto/>
PREFIX misura: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/misura/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX oa: <http://www.w3.org/ns/oa#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT ?tabella ?regola ?motivazione (COUNT(?i) AS ?n) (SAMPLE(?m) AS ?esempio) WHERE {
  ?i a bj:Intervento ; bj:tabellaFonte ?tabella ; bj:regola/skos:prefLabel ?regola ; oa:motivatedBy ?mot .
  FILTER (LANG(?regola) = "it")
  OPTIONAL { ?i oa:hasBody/rdf:value ?m }
  BIND (STRAFTER(STR(?mot), "#") AS ?motivazione)
}
GROUP BY ?tabella ?regola ?motivazione
ORDER BY DESC(?n) ?tabella
