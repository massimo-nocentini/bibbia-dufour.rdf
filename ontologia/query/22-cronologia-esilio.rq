# La tavola cronologica fra il 600 e il 530 a.C. (l'esilio): data come stampata, colonna,
# testo e versetti citati; gli anni sono negativi prima di Cristo.
# The chronological table between 600 and 530 BC (the exile): printed date, column, text and
# verses cited; years are negative before Christ.
PREFIX bj: <https://massimo-nocentini.github.io/bibbia-gerusalemme/ontologia#>
PREFIX verso: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/verso/>
PREFIX libro: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/libro/>
PREFIX indice: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/indice/>
PREFIX cronologia: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/cronologia/>
PREFIX dinastia: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/dinastia/>
PREFIX canone: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/canone/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <https://schema.org/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT ?data ?inizio ?fine ?colonna (SUBSTR(?testo, 1, 80) AS ?voce) (GROUP_CONCAT(?rif; separator=" | ") AS ?riferimenti) WHERE {
  ?e a bj:EventoCronologia ; bj:annoInizio ?inizio ; bj:annoFine ?fine ; bj:datazione ?data ; bj:testo ?testo ;
     bj:colonna/skos:prefLabel ?colonna ; bj:riga ?riga ; bj:ordine ?o .
  FILTER (?inizio >= -600 && ?fine <= -530 && lang(?colonna) = "it")
  OPTIONAL { ?c bj:daEvento ?e ; bj:testo ?r0 }
  BIND (COALESCE(?r0, "") AS ?rif)
}
GROUP BY ?data ?inizio ?fine ?colonna ?testo ?riga ?o
ORDER BY ?riga ?o
