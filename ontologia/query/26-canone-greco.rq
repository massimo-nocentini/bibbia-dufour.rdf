# La divisione della Bibbia greca: i libri deuterocanonici (stampati in corsivo) e i libri o i
# capitoli di questa Bibbia a cui corrispondono.
# The division of the Greek Bible: the deuterocanonical books and the books or chapters of this
# Bible they correspond to.
PREFIX bj: <https://massimo-nocentini.github.io/bibbia-gerusalemme/ontologia#>
PREFIX verso: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/verso/>
PREFIX libro: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/libro/>
PREFIX indice: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/indice/>
PREFIX cronologia: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/cronologia/>
PREFIX dinastia: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/dinastia/>
PREFIX canone: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/canone/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <https://schema.org/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT ?voce ?gruppo (GROUP_CONCAT(DISTINCT ?l; separator=" | ") AS ?in_questa_bibbia) WHERE {
  ?x dcterms:isPartOf ?g ; bj:deuterocanonico true ; bj:testo ?voce ; bj:ordine ?o .
  ?g dcterms:isPartOf canone:greco ; dcterms:title ?gruppo .
  ?x bj:comprendeLibro|bj:comprendeCapitolo ?b .
  ?b rdfs:label ?l .
}
GROUP BY ?voce ?gruppo ?o
ORDER BY ?o
