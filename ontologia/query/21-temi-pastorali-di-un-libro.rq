# I temi dell’indice dei temi biblici d’interesse pastorale che indicano più versetti di un libro (Tobia),
# con il numero di versetti e le sottovoci (scorciatoia bj:nellIndice).
# The pastoral themes pointing to most verses of a book, with the number of verses and the
# sub-themes citing it.
PREFIX bj: <https://massimo-nocentini.github.io/bibbia-gerusalemme/ontologia#>
PREFIX verso: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/verso/>
PREFIX libro: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/libro/>
PREFIX indice: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/indice/>
PREFIX cronologia: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/cronologia/>
PREFIX dinastia: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/dinastia/>
PREFIX canone: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/canone/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <https://schema.org/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT ?tema (COUNT(DISTINCT ?v) AS ?versetti) (GROUP_CONCAT(DISTINCT ?sotto; separator=" | ") AS ?sottotemi) WHERE {
  ?v bj:inLibro libro:Tob ; bj:nellIndice ?x .
  ?x skos:inScheme indice:temi ; skos:prefLabel ?sotto .
  OPTIONAL { ?x skos:broader ?b }
  BIND (COALESCE(?b, ?x) AS ?t)
  ?t skos:prefLabel ?tema .
}
GROUP BY ?tema
ORDER BY DESC(?versetti) ?tema
