# Una voce dell'indice delle note (Alleanza) con le sue sottovoci, i riferimenti e l'inizio
# delle note della BJ a cui mandano: l'indice come porta d'ingresso alle note chiave.
# An entry of the index of notes with its sub-entries, references and the start of the BJ notes
# they send to: the index as a way into the key notes.
PREFIX bj: <https://massimo-nocentini.github.io/bibbia-gerusalemme/ontologia#>
PREFIX verso: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/verso/>
PREFIX libro: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/libro/>
PREFIX indice: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/indice/>
PREFIX cronologia: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/cronologia/>
PREFIX dinastia: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/dinastia/>
PREFIX canone: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/canone/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <https://schema.org/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

PREFIX oa: <http://www.w3.org/ns/oa#>
SELECT ?sottovoce ?riferimento ?nota (SUBSTR(?testo, 1, 90) AS ?inizio_della_nota) WHERE {
  ?v skos:inScheme indice:note ; skos:topConceptOf indice:note ; skos:prefLabel "Alleanza"@it .
  { ?c bj:daVoceIndice ?v . BIND("(la voce)" AS ?sottovoce) }
  UNION
  { ?x skos:broader ?v ; skos:prefLabel ?sottovoce . ?c bj:daVoceIndice ?x }
  ?c bj:testo ?riferimento ; bj:ordine ?o .
  OPTIONAL { ?c bj:indicaNota ?n . ?n rdfs:label ?nota ; oa:hasBody/rdf:value ?testo }
}
ORDER BY ?o
