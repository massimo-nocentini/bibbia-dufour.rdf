# I componimenti alfabetici: per ogni libro e capitolo, quante lettere acrostiche, il rigo dove
# comincia la strofa di Bet (2: il primo versetto che la porta, in Lam 3 ogni lettera apre tre
# versetti) e le lettere che mancano nel testo ebraico.
# The alphabetic poems: for each book and chapter, how many acrostic letters, the line where the
# Bet (2) stanza begins (the first verse that carries it: in Lam 3 each letter opens three verses)
# and the letters missing in the Hebrew text.
PREFIX bj: <https://massimo-nocentini.github.io/bibbia-gerusalemme/ontologia#>
PREFIX verso: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/verso/>
PREFIX libro: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/libro/>
PREFIX indice: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/indice/>
PREFIX cronologia: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/cronologia/>
PREFIX dinastia: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/dinastia/>
PREFIX canone: <https://massimo-nocentini.github.io/bibbia-gerusalemme/id/canone/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <https://schema.org/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT ?capitolo ?lettere ?strofa_di_bet ?mancanti WHERE {
  { SELECT ?k ?capitolo ?ol ?n (COUNT(DISTINCT ?a) AS ?lettere)
           (MIN(IF(?pos = 2, ?ov * 100 + ?r, 1000000000)) AS ?primo)
           (GROUP_CONCAT(DISTINCT ?manca; separator=" ") AS ?mancanti) WHERE {
      ?v bj:haLetteraAcrostica ?a ; dcterms:isPartOf ?k ; bj:ordine ?ov .
      ?k rdfs:label ?capitolo ; bj:numero ?n ; bj:inLibro/bj:ordine ?ol .
      ?a bj:posizioneAlfabeto ?pos ; bj:rigo ?r ; bj:testo ?t .
      OPTIONAL { ?a bj:mancanteNelTesto ?m0 }
      BIND (IF(BOUND(?m0), ?t, "") AS ?manca)
    }
    GROUP BY ?k ?capitolo ?ol ?n }
  OPTIONAL { ?b dcterms:isPartOf ?k ; bj:ordine ?ob ; rdfs:label ?lb ; bj:haLetteraAcrostica ?ab .
             ?ab bj:posizioneAlfabeto 2 ; bj:rigo ?rb
             FILTER (?ob * 100 + ?rb = ?primo) }
  BIND (IF(BOUND(?lb), CONCAT(?lb, ", rigo ", STR(?rb)), "") AS ?strofa_di_bet)
}
ORDER BY ?ol ?n
